{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Structures de contrôle
{% endblock %}

{% block body %}
	<!-- Header spécifique aux structures de contrôle -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// STRUCTURES DE CONTRÔLE PHP</h1>
				<p class="header-subtitle">
					Maîtrisez les structures de contrôle PHP : conditions, boucles, exceptions et fonctionnalités modernes PHP 7/8.
															Contrôlez le flux d'exécution de vos programmes avec précision et élégance.
				</p>
			</div>
		</div>
	</header>

	<!-- Contenu principal - Structures de contrôle -->
	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Structures conditionnelles</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['structures_conditionnelles', 'condition_if_else', 'operateur_ternaire_moderne', 'structure_switch', 'expression_match_php8'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'_': ' ', 'operateur ': '', 'structure ': '', 'expression ': ''})|title,
							'description': concept.description,
							'icon': key == 'structures_conditionnelles' ? '🔀' : (key == 'condition_if_else' ? '✔️' : (key == 'operateur_ternaire_moderne' ? '❓' : (key == 'structure_switch' ? '🔄' : '🎯'))),
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Boucles -->
			<h2 class="section-title">Structures itératives (boucles)</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['boucles_for', 'boucles_while', 'boucles_foreach', 'controle_boucles'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'boucles_': '', '_': ' '})|title,
							'description': concept.description,
							'icon': key == 'boucles_for' ? '🔢' : (key == 'boucles_while' ? '🔁' : (key == 'boucles_foreach' ? '📦' : '⏸️')),
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Inclusion & Exceptions -->
			<h2 class="section-title">Inclusion & gestion d'erreurs</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['include_require', 'try_catch_finally', 'throw_exceptions'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'_': ' '})|title,
							'description': concept.description,
							'icon': key == 'include_require' ? '📁' : (key == 'try_catch_finally' ? '🛡️' : '⚠️'),
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Structures avancées -->
			<h2 class="section-title">Structures avancées & modernes</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['goto_labels', 'declare_directives', 'return_yield', 'structures_alternatives'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'_': ' '})|title,
							'description': concept.description,
							'icon': key == 'goto_labels' ? '🔀' : (key == 'declare_directives' ? '⚙️' : (key == 'return_yield' ? '🔄' : '📝')),
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</main>

	<!-- Modales pour chaque structure -->
	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
			'id': 'modal-' ~ key,
			'title': key|replace({'_': ' ', 'operateur ': '', 'structure ': '', 'expression ': '', 'boucles ': ''})|title,
			'description': concept.description,
			'details': concept.details,
			'example': concept.example,
			'useCases': concept.useCases,
			'warnings': concept.warnings,
			'bestPractices': concept.bestPractices,
			'resources': concept.resources,
			'relatedTopics': concept.relatedTopics
		} %}
	{% endfor %}

	<!-- Effet Matrix de fond -->
	<div class="matrix-bg" id="matrix-canvas"></div>

	<style>
		.section-title {
			color: var(--matrix-green);
			font-size: 2rem;
			margin: 3rem 0 2rem;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 2px;
			border-bottom: 2px solid var(--matrix-green);
			padding-bottom: 1rem;
		}

		@media(max-width: 768px) {
			.section-title {
				font-size: 1.5rem;
			}
		}
	</style>
{% endblock %}
