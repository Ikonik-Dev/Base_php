{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Structures de contrôle
{% endblock %}

{% block body %}
	<!-- Header spécifique aux structures de contrôle -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// STRUCTURES DE CONTRÔLE PHP</h1>
				<p class="header-subtitle">
					Maîtrisez les structures de contrôle PHP : conditions, boucles, exceptions et fonctionnalités modernes PHP 7/8.
										Contrôlez le flux d'exécution de vos programmes avec précision et élégance.
				</p>
			</div>
		</div>
	</header>

	<!-- Contenu principal - Structures de contrôle -->
	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Structures conditionnelles</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['structures_conditionnelles', 'condition_if_else', 'operateur_ternaire_moderne', 'structure_switch', 'expression_match_php8'] %}
						<article id="{{ key }}" class="concept-card conditional-card">
							<h3 class="concept-card-title">
								{{ key|replace({'_': ' ', 'operateur ': '', 'structure ': '', 'expression ': ''})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Boucles -->
			<h2 class="section-title">Structures itératives (boucles)</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['boucles_for', 'boucles_while', 'boucles_foreach', 'controle_boucles'] %}
						<article id="{{ key }}" class="concept-card loop-card">
							<h3 class="concept-card-title">
								{{ key|replace({'boucles_': '', '_': ' '})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Inclusion & Exceptions -->
			<h2 class="section-title">Inclusion & gestion d'erreurs</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['include_require', 'try_catch_finally', 'throw_exceptions'] %}
						<article id="{{ key }}" class="concept-card error-card">
							<h3 class="concept-card-title">
								{{ key|replace({'_': ' '})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Structures avancées -->
			<h2 class="section-title">Structures avancées & modernes</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['goto_labels', 'declare_directives', 'return_yield', 'structures_alternatives'] %}
						<article id="{{ key }}" class="concept-card advanced-card">
							<h3 class="concept-card-title">
								{{ key|replace({'_': ' '})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</main>

	<!-- Effet Matrix de fond -->
	<div class="matrix-bg" id="matrix-canvas"></div>

	<script>
		// Script pour l'effet Matrix et animations
document.addEventListener('DOMContentLoaded', function () { // Animation d'apparition des cartes
const cards = document.querySelectorAll('.concept-card');

cards.forEach((card, index) => {
card.style.animationDelay = `${
index * 0.1
}s`;
card.style.animation = 'fadeInUp 0.6s ease-out forwards';

// Effet de hover avancé
card.addEventListener('mouseenter', function () {
this.style.transform = 'translateY(-8px) scale(1.02)';
});

card.addEventListener('mouseleave', function () {
this.style.transform = 'translateY(0) scale(1)';
});
});

// Smooth scroll pour la navigation (si présente)
document.querySelectorAll('.nav-link').forEach(link => {
link.addEventListener('click', function (e) {
e.preventDefault();
const targetId = this.getAttribute('href').substring(1);
const targetElement = document.getElementById(targetId);

if (targetElement) {
targetElement.scrollIntoView({behavior: 'smooth', block: 'center'});

// Effet de highlight temporaire
targetElement.style.boxShadow = '0 0 20px var(--matrix-glow)';
setTimeout(() => {
targetElement.style.boxShadow = '';
}, 2000);
}
});
});
});
	</script>

	<style>
		/* Styles spécifiques à la page Structures de contrôle */
		.section-title {
			color: var(--matrix-green);
			font-size: 2rem;
			margin: 3rem 0 2rem;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 2px;
			border-bottom: 2px solid var(--matrix-green);
			padding-bottom: 1rem;
		}

		/* Animations personnalisées */
		@keyframes fadeInUp {
			from {
				opacity: 0;
				transform: translateY(30px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		/* Style initial pour les cartes avant animation */
		.concept-card {
			opacity: 0;
		}

		/* Styles spéciaux par catégorie de structures */
		.conditional-card {
			border-left: 4px solid #00ff41; /* Vert Matrix pour conditions */
		}

		.loop-card {
			border-left: 4px solid #41ff00; /* Vert clair pour boucles */
		}

		.error-card {
			border-left: 4px solid #ff4100; /* Orange pour erreurs/inclusion */
		}

		.advanced-card {
			border-left: 4px solid #0041ff; /* Bleu pour avancées */
		}

		/* Titres colorés par catégorie */
		.conditional-card .concept-card-title {
			color: #00ff41;
		}

		.loop-card .concept-card-title {
			color: #41ff00;
		}

		.error-card .concept-card-title {
			color: #ff4100;
		}

		.advanced-card .concept-card-title {
			color: #0041ff;
		}

		/* Style pour l'effet de focus sur les cartes */
		.concept-card:focus {
			outline: 2px solid var(--matrix-green);
			outline-offset: 2px;
		}

		/* Amélioration des exemples de code */
		.concept-card-example pre {
			background: rgba(0, 0, 0, 0.3);
			border: 1px solid var(--matrix-green);
			border-radius: 4px;
			padding: 1rem;
			margin-top: 0.5rem;
			overflow-x: auto;
		}

		.concept-card-example code {
			color: var(--matrix-green);
			font-family: 'Courier New', monospace;
			font-size: 0.9rem;
			line-height: 1.4;
			white-space: pre;
		}

		.concept-card-example::before {
			content: '$ ';
			color: var(--matrix-green);
			font-weight: bold;
		}

		/* Responsiveness améliorée */
		@media(max-width: 768px) {
			.section-title {
				font-size: 1.5rem;
			}

			.concept-card-example pre {
				font-size: 0.8rem;
				padding: 0.5rem;
			}
		}
	</style>
{% endblock %}
