<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Cours PHP et Symfony
			{% endblock %}
		</title>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
		<link rel="icon" type="image/png" sizes="32x32" href="{{ asset('php-logo.png') }}">
		<link rel="apple-touch-icon" href="{{ asset('php-logo.png') }}">
		<meta name="theme-color" content="#777BB4">
		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		{% endblock %}

		{% block javascripts %}
			{{ importmap('app') }}
		{% endblock %}
	</head>
	<body>
		{# Zone de détection pour faire apparaître la navbar #}
		<div class="navbar-trigger" id="navbarTrigger"></div>

		{# Bouton toggle pour mobile #}
		<button class="sidebar-toggle"></button>

		{# Navigation principale avec le nouveau composant #}
		{% include 'components/sidebar.html.twig' with {
			title: 'LES BASES',
			sections: [
				{
					items: [
						{ label: 'Accueil', path: path('app_home'), route: 'app_home' },
						{ label: 'Variables', path: path('app_variables'), route: 'app_variables' },
						{ label: 'Types de données', path: path('app_typages'), route: 'app_typages' },
						{ label: 'Opérateurs', path: path('app_operateurs'), route: 'app_operateurs' },
						{ label: 'Structures de contrôle', path: path('app_structure_controle'), route: 'app_structure_controle' },
						{ label: 'Fonctions', path: path('app_fonctions'), route: 'app_fonctions' },
						{ label: 'POO', path: path('app_poo'), route: 'app_poo' },
						{ label: 'Bases de données', path: path('app_bdd'), route: 'app_bdd' },
						{ label: '🌐 Infrastructure Web', path: path('app_infrastructure'), route: 'app_infrastructure' }
					]
				},
				{
					separator: true,
					title: 'PRATIQUE',
					items: [
						{ label: '🎮 Projet POO Progressif', path: path('app_projet_poo'), route: 'app_projet_poo' },
						{ label: '🏗️ Intro MVC Pratique', path: path('app_intro_mvc'), route: 'app_intro_mvc' },
						{ label: '🛒 E-commerce Symfony', path: path('app_ecommerce'), route: 'app_ecommerce' }
					]
				},
				{
					separator: true,
					title: 'RÉFÉRENCE',
					items: [
						{ label: '🎵 Framework Symfony', path: path('app_symfony'), route: 'app_symfony' },
						{ label: '🥏 Terminologie & Concepts', path: path('app_glossaire'), route: 'app_glossaire', class: 'glossaire-item' }
					]
				}
			]
		} %}

		{# Navigation composant améliorée #}
		{% include 'components/navigation.html.twig' %}

		{% block body %}{% endblock %}

		{# Le JavaScript est maintenant géré par les modules ES6 via importmap dans le head #}
	</body>
</html>
