{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Formation Complète{% endblock %}

{% block body %}
<header class="header">
<div class="container">
<div class="header-content">
<h1 class="header-title">// FORMATION PHP</h1>
<p class="header-subtitle">
Explorez les concepts fondamentaux du PHP dans un environnement Matrix.
Chaque notion est une porte vers la maîtrise du développement web.
</p>
</div>
</div>
</header>

<main class="main-content">
<div class="container">
<h2 class="section-title">Modules de Formation</h2>
<div class="grid">
{% include 'components/card.html.twig' with {
'modalId': 'modal-variables',
'title': 'Variables',
'description': data.variables.description,
'example': data.variables.example,
'iconClass': 'fa-solid fa-dollar-sign'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-types_de_donnees',
'title': 'Types de Données',
'description': data.types_de_donnees.description,
'example': data.types_de_donnees.example,
'iconClass': 'fa-solid fa-list-check'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-operateurs',
'title': 'Opérateurs',
'description': data.operateurs.description,
'example': data.operateurs.example,
'iconClass': 'fa-solid fa-plus-minus'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-structures_de_controle',
'title': 'Structures de Contrôle',
'description': data.structures_de_controle.description,
'example': data.structures_de_controle.example,
'iconClass': 'fa-solid fa-code-branch'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-fonctions',
'title': 'Fonctions',
'description': data.fonctions.description,
'example': data.fonctions.example,
'iconClass': 'fa-solid fa-function'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-tableaux',
'title': 'Tableaux',
'description': data.tableaux.description,
'example': data.tableaux.example,
'iconClass': 'fa-solid fa-table'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-manipulation_de_chaines',
'title': 'Manipulation de Chaînes',
'description': data.manipulation_de_chaines.description,
'example': data.manipulation_de_chaines.example,
'iconClass': 'fa-solid fa-text-width'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-gestion_des_erreurs',
'title': 'Gestion des Erreurs',
'description': data.gestion_des_erreurs.description,
'example': data.gestion_des_erreurs.example,
'iconClass': 'fa-solid fa-triangle-exclamation'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-programmation_orientee_objet',
'title': 'POO',
'description': data.programmation_orientee_objet.description,
'example': data.programmation_orientee_objet.example,
'iconClass': 'fa-solid fa-cube'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-interaction_avec_les_bases_de_donnees',
'title': 'Bases de Données',
'description': data.interaction_avec_les_bases_de_donnees.description,
'example': data.interaction_avec_les_bases_de_donnees.example,
'iconClass': 'fa-solid fa-database'
} %}
{% include 'components/card.html.twig' with {
'modalId': 'modal-infrastructure_web',
'title': 'Infrastructure Web',
'description': data.infrastructure_web.description,
'example': data.infrastructure_web.example,
'iconClass': 'fa-solid fa-server'
} %}
</div>
</div>
</main>

{% for key, concept in data %}
{% include 'components/modal.html.twig' with {
'id': 'modal-' ~ key,
'title': key|replace({'_': ' '})|title,
'description': concept.description,
'example': concept.example,
'details': concept.details|default(null),
'useCases': concept.useCases|default([]),
'warnings': concept.warnings|default([]),
'bestPractices': concept.bestPractices|default([]),
'resources': concept.resources|default([]),
'relatedTopics': concept.relatedTopics|default([])
} %}
{% endfor %}

<div class="matrix-bg" id="matrix-canvas"></div>
{% endblock %}