{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Programmation Orientée Objet
{% endblock %}

{% block body %}
	<!-- Header POO -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// PROGRAMMATION ORIENTÉE OBJET</h1>
				<p class="header-subtitle">
					Découvrez la puissance de la POO en PHP : classes, objets, héritage, encapsulation et polymorphisme.
															Organisez votre code de manière professionnelle et maintenable.
				</p>
			</div>
		</div>
	</header>

	<main class="main-content">
		<div
			class="container">
			<!-- Section 1 : Concepts Fondamentaux -->
			<h2 class="section-title">Concepts Fondamentaux</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-introduction',
					'title': 'Introduction',
					'description': data.introduction.description,
					'example': data.introduction.example,
					'iconClass': 'fa-solid fa-circle-info'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-classes_et_objets',
					'title': 'Classes Et Objets',
					'description': data.classes_et_objets.description,
					'example': data.classes_et_objets.example,
					'iconClass': 'fa-solid fa-cube'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-proprietes_et_methodes',
					'title': 'Propriétés Et Méthodes',
					'description': data.proprietes_et_methodes.description,
					'example': data.proprietes_et_methodes.example,
					'iconClass': 'fa-solid fa-cubes'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-constructeur_destructeur',
					'title': 'Constructeur Destructeur',
					'description': data.constructeur_destructeur.description,
					'example': data.constructeur_destructeur.example,
					'iconClass': 'fa-solid fa-hammer'
				} %}
			</div>

			<!-- Section 2 : Encapsulation et Visibilité -->
			<h2 class="section-title">Encapsulation et Visibilité</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-visibilite_encapsulation',
					'title': 'Visibilité Encapsulation',
					'description': data.visibilite_encapsulation.description,
					'example': data.visibilite_encapsulation.example,
					'iconClass': 'fa-solid fa-lock'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-proprietes_methodes_statiques',
					'title': 'Propriétés Méthodes Statiques',
					'description': data.proprietes_methodes_statiques.description,
					'example': data.proprietes_methodes_statiques.example,
					'iconClass': 'fa-solid fa-arrows-to-dot'
				} %}
			</div>

			<!-- Section 3 : Héritage et Abstraction -->
			<h2 class="section-title">Héritage et Abstraction</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-heritage',
					'title': 'Héritage',
					'description': data.heritage.description,
					'example': data.heritage.example,
					'iconClass': 'fa-solid fa-diagram-project'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-abstraction',
					'title': 'Abstraction',
					'description': data.abstraction.description,
					'example': data.abstraction.example,
					'iconClass': 'fa-solid fa-layer-group'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-interfaces',
					'title': 'Interfaces',
					'description': data.interfaces.description,
					'example': data.interfaces.example,
					'iconClass': 'fa-solid fa-plug'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-polymorphisme',
					'title': 'Polymorphisme',
					'description': data.polymorphisme.description,
					'example': data.polymorphisme.example,
					'iconClass': 'fa-solid fa-shapes'
				} %}
			</div>

			<!-- Section 4 : Réutilisation du Code -->
			<h2 class="section-title">Réutilisation du Code</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-traits',
					'title': 'Traits',
					'description': data.traits.description,
					'example': data.traits.example,
					'iconClass': 'fa-solid fa-puzzle-piece'
				} %}
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-namespaces',
					'title': 'Namespaces',
					'description': data.namespaces.description,
					'example': data.namespaces.example,
					'iconClass': 'fa-solid fa-folder-tree'
				} %}
			</div>

			<!-- Section 5 : Gestion des Erreurs -->
			<h2 class="section-title">Gestion des Erreurs</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
					'modalId': 'modal-exceptions_poo',
					'title': 'Exceptions POO',
					'description': data.exceptions_poo.description,
					'example': data.exceptions_poo.example,
					'iconClass': 'fa-solid fa-triangle-exclamation'
				} %}
			</div>
		</div>
	</main>

	<!-- Modales -->
	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
			'id': 'modal-' ~ key,
			'title': key|replace({'_': ' '})|title,
			'description': concept.description,
			'example': concept.example,
			'details': concept.details|default(null),
			'useCases': concept.useCases|default([]),
			'warnings': concept.warnings|default([]),
			'bestPractices': concept.bestPractices|default([]),
			'resources': concept.resources|default([]),
			'relatedTopics': concept.relatedTopics|default([])
		} %}
	{% endfor %}

	<!-- Effet Matrix -->
	<div class="matrix-bg" id="matrix-canvas"></div>
{% endblock %}
