}

.tool-item:hover {
background: var(--infra-accent);
transform: scale(1.02);
color: white;
}
border-radius: 5px;
}

.tool-name {
font-weight: bold;
color: var(--infra-primary);
margin-bottom: 0.25rem;
}

.tool-description {
font-size: 0.9rem;
color: #666;
}

/* Call to Action */
.cta-section {
background: var(--infra-gradient);
color: white;
padding: 3rem 0;
