{% extends 'base.html.twig' %}

{% block title %}
	{{ pageTitle }}
	- Cours PHP Matrix
{% endblock %}

{% block body %}
	<div
		class="infrastructure-page">
		<!-- Header avec style spécifique Infrastructure -->
		<header class="infrastructure-header">
			<div class="container">
				<h1 class="page-title">
					<span class="icon">🌐</span>
					Infrastructure Web & PHP
				</h1>
				<p class="page-subtitle">
					Comprendre l'écosystème web et la place de PHP dans l'architecture moderne
				</p>
			</div>
		</header>

		<!-- Navigation rapide -->
		<nav class="quick-nav">
			<div class="container">
				<div class="nav-pills">
					<a href="#architecture" class="nav-pill">Architecture</a>
					<a href="#pile-tech" class="nav-pill">Pile Tech</a>
					<a href="#http-cycle" class="nav-pill">Cycle HTTP</a>
					<a href="#php-role" class="nav-pill">Rôle PHP</a>
					<a href="#diagrams" class="nav-pill">Diagrammes</a>
				</div>
			</div>
		</nav>

		<!-- Section principale avec diagrammes -->
		<main class="main-content">
			<div
				class="container">

				<!-- Diagramme Architecture Client-Serveur -->
				<section id="architecture" class="concept-section">
					<h2>{{ concepts.architecture_client_serveur.label }}</h2>
					<p class="section-description">{{ concepts.architecture_client_serveur.description }}</p>

					<div class="diagram-container">
						<div class="client-server-diagram">
							<div class="client-side">
								<div class="client-box">
									<div class="browser-icon">🌐</div>
									<h3>CLIENT</h3>
									<p>Navigateur Web</p>
									<ul>
										<li>Chrome, Firefox, Safari</li>
										<li>Interprète HTML/CSS/JS</li>
										<li>Envoie requêtes HTTP</li>
									</ul>
								</div>
							</div>

							<div class="communication-flow">
								<div class="request-arrow">
									<span class="arrow-label">Requête HTTP</span>
									<div class="arrow">→</div>
								</div>
								<div class="response-arrow">
									<div class="arrow">←</div>
									<span class="arrow-label">Réponse HTTP</span>
								</div>
							</div>

							<div class="server-side">
								<div class="server-box">
									<div class="server-icon">🖥️</div>
									<h3>SERVEUR</h3>
									<p>Serveur Web</p>
									<ul>
										<li>Apache, Nginx</li>
										<li>Exécute PHP</li>
										<li>Accès base de données</li>
									</ul>
								</div>
							</div>
						</div>
					</div>

					{# Analogie pour architecture client-serveur #}
					{% if concepts.architecture_client_serveur.analogie is defined %}
						<div class="analogy-box">
							<div class="analogy-icon">💡</div>
							<div class="analogy-content">
								<strong>Analogie pour comprendre :</strong>
								<p>{{ concepts.architecture_client_serveur.analogie }}</p>
							</div>
						</div>
					{% endif %}

					{# Exemple concret #}
					{% if concepts.architecture_client_serveur.exemple_concret is defined %}
						<div class="example-box">
							<div class="example-icon">🔍</div>
							<div class="example-content">
								<strong>Exemple concret :</strong>
								<p>{{ concepts.architecture_client_serveur.exemple_concret }}</p>
							</div>
						</div>
					{% endif %}
				</section>

				<!-- Diagramme Pile LAMP/LEMP -->
				<section id="pile-tech" class="concept-section">
					<h2>{{ concepts.pile_lamp_lemp.label }}</h2>
					<p class="section-description">{{ concepts.pile_lamp_lemp.description }}</p>

					<div class="diagram-container">
						<div class="lamp-stack-diagram">
							<div class="stack-layer os-layer">
								<div class="layer-icon">🐧</div>
								<div class="layer-content">
									<h3>LINUX</h3>
									<p>Système d'exploitation</p>
									<span class="layer-description">Ubuntu, CentOS, Debian</span>
								</div>
							</div>

							<div class="stack-layer web-server-layer">
								<div class="layer-icon">⚡</div>
								<div class="layer-content">
									<h3>APACHE / NGINX</h3>
									<p>Serveur Web</p>
									<span class="layer-description">Traite les requêtes HTTP</span>
								</div>
							</div>

							<div class="stack-layer database-layer">
								<div class="layer-icon">🗄️</div>
								<div class="layer-content">
									<h3>MYSQL</h3>
									<p>Base de données</p>
									<span class="layer-description">Stockage des données</span>
								</div>
							</div>

							<div class="stack-layer php-layer">
								<div class="layer-icon">🐘</div>
								<div class="layer-content">
									<h3>PHP</h3>
									<p>Langage de programmation</p>
									<span class="layer-description">Logique métier côté serveur</span>
								</div>
							</div>
						</div>
					</div>

					{# Variantes de la pile #}
					{% if concepts.pile_lamp_lemp.variantes is defined %}
						<div class="variants-grid">
							<h4>🔄 Variantes courantes</h4>
							<div class="variants-cards">
								{% for nom, desc in concepts.pile_lamp_lemp.variantes %}
									<div class="variant-card">
										<span class="variant-name">{{ nom }}</span>
										<span class="variant-desc">{{ desc }}</span>
									</div>
								{% endfor %}
							</div>
						</div>
					{% endif %}

					{# Analogie pour pile LAMP #}
					{% if concepts.pile_lamp_lemp.analogie is defined %}
						<div class="analogy-box">
							<div class="analogy-icon">💡</div>
							<div class="analogy-content">
								<strong>Analogie pour comprendre :</strong>
								<p>{{ concepts.pile_lamp_lemp.analogie }}</p>
							</div>
						</div>
					{% endif %}
				</section>

				<!-- Diagramme Cycle HTTP -->
				<section id="http-cycle" class="concept-section">
					<h2>{{ concepts.cycle_requete_reponse.label }}</h2>
					<p class="section-description">{{ concepts.cycle_requete_reponse.description }}</p>

					<div class="diagram-container">
						<div class="http-cycle-diagram">
							<div class="cycle-step step-1">
								<div class="step-number">1</div>
								<div class="step-content">
									<h4>Requête HTTP</h4>
									<p>GET /page.php</p>
									<code>User-Agent: Browser<br>Accept: text/html</code>
								</div>
							</div>

							<div class="cycle-arrow">→</div>

							<div class="cycle-step step-2">
								<div class="step-number">2</div>
								<div class="step-content">
									<h4>Routage</h4>
									<p>Apache/Nginx</p>
									<code>Document Root<br>/var/www/html</code>
								</div>
							</div>

							<div class="cycle-arrow">→</div>

							<div class="cycle-step step-3">
								<div class="step-number">3</div>
								<div class="step-content">
									<h4>Traitement PHP</h4>
									<p>Exécution script</p>
									<code>Database Query<br>Business Logic</code>
								</div>
							</div>

							<div class="cycle-arrow">→</div>

							<div class="cycle-step step-4">
								<div class="step-number">4</div>
								<div class="step-content">
									<h4>Réponse HTTP</h4>
									<p>200 OK</p>
									<code>Content-Type: text/html<br>&lt;html&gt;...&lt;/html&gt;</code>
								</div>
							</div>
						</div>

						{# Codes HTTP visuels #}
						{% if concepts.cycle_requete_reponse.codes_http is defined %}
							<div class="http-codes-visual">
								<h4>📊 Codes HTTP les plus courants</h4>
								<div class="codes-grid">
									{% for code, description in concepts.cycle_requete_reponse.codes_http %}
										<div class="code-badge {% if '200' in code %}success{% elseif '301' in code or '302' in code %}redirect{% elseif '404' in code %}not-found{% else %}error{% endif %}">
											<span class="code-number">{{ code }}</span>
											<span class="code-desc">{{ description }}</span>
										</div>
									{% endfor %}
								</div>
							</div>
						{% endif %}

						{# Analogie visuelle #}
						{% if concepts.cycle_requete_reponse.analogie is defined %}
							<div class="analogy-box">
								<div class="analogy-icon">💡</div>
								<div class="analogy-content">
									<strong>Analogie pour comprendre :</strong>
									<p>{{ concepts.cycle_requete_reponse.analogie }}</p>
								</div>
							</div>
						{% endif %}
					</div>
				</section>

				<!-- Rôle de PHP -->
				<section id="php-role" class="concept-section">
					<h2>{{ concepts.role_de_php.label }}</h2>
					<p class="section-description">{{ concepts.role_de_php.description }}</p>

					<div class="php-role-grid">
						{% for detail, description in concepts.role_de_php.details %}
							<div class="role-card">
								<div class="role-icon">
									{% if 'génération' in detail|lower %}🎨
										{% elseif 'formulaires' in detail|lower %}📝
										{% elseif 'session' in detail|lower %}👤
										{% else %}🗃️
									{% endif %}
								</div>
								<h4>{{ detail }}</h4>
								<p>{{ description }}</p>
							</div>
						{% endfor %}
					</div>

					{# Sites célèbres utilisant PHP #}
					{% if concepts.role_de_php.sites_celebres is defined %}
						<div class="famous-sites">
							<h4>🌟 PHP propulse des géants du web</h4>
							<div class="sites-badges">
								{% for site, info in concepts.role_de_php.sites_celebres %}
									<div class="site-badge">
										<span class="site-name">{{ site }}</span>
										<span class="site-info">{{ info }}</span>
									</div>
								{% endfor %}
							</div>
						</div>
					{% endif %}

					{# Analogie #}
					{% if concepts.role_de_php.analogie is defined %}
						<div class="analogy-box">
							<div class="analogy-icon">💡</div>
							<div class="analogy-content">
								<strong>Analogie pour comprendre :</strong>
								<p>{{ concepts.role_de_php.analogie }}</p>
							</div>
						</div>
					{% endif %}
				</section>

				<!-- NOUVEAU : Frontend vs Backend -->
				{% if concepts.frontend_vs_backend is defined %}
					<section id="frontend-backend" class="concept-section">
						<h2>{{ concepts.frontend_vs_backend.label }}</h2>
						<p class="section-description">{{ concepts.frontend_vs_backend.description }}</p>

						<div class="frontend-backend-diagram">
							<div class="diagram-side frontend-side">
								<div class="side-header">
									<span class="side-icon">🎨</span>
									<h3>FRONTEND</h3>
									<span class="side-subtitle">Ce que l'utilisateur voit</span>
								</div>
								<div class="side-content">
									<ul>
										<li>
											<span class="tech-badge html">HTML</span>
											Structure</li>
										<li>
											<span class="tech-badge css">CSS</span>
											Style & Design</li>
										<li>
											<span class="tech-badge js">JavaScript</span>
											Interactivité</li>
									</ul>
									<div class="execution-note">⚡ S'exécute dans le NAVIGATEUR</div>
								</div>
							</div>

							<div class="diagram-middle">
								<div class="api-bridge">
									<span class="bridge-arrow">⇄</span>
									<span class="bridge-label">API / HTTP</span>
								</div>
							</div>

							<div class="diagram-side backend-side">
								<div class="side-header">
									<span class="side-icon">⚙️</span>
									<h3>BACKEND</h3>
									<span class="side-subtitle">Les coulisses invisibles</span>
								</div>
								<div class="side-content">
									<ul>
										<li>
											<span class="tech-badge php">PHP</span>
											Logique métier</li>
										<li>
											<span class="tech-badge mysql">MySQL</span>
											Base de données</li>
										<li>
											<span class="tech-badge server">Serveur</span>
											Sécurité</li>
									</ul>
									<div class="execution-note">🖥️ S'exécute sur le SERVEUR</div>
								</div>
							</div>
						</div>

						{% if concepts.frontend_vs_backend.analogie is defined %}
							<div class="analogy-box">
								<div class="analogy-icon">💡</div>
								<div class="analogy-content">
									<strong>Analogie pour comprendre :</strong>
									<p>{{ concepts.frontend_vs_backend.analogie }}</p>
								</div>
							</div>
						{% endif %}
					</section>
				{% endif %}

				<!-- NOUVEAU : Types d'hébergement -->
				{% if concepts.hebergement_web is defined %}
					<section id="hebergement" class="concept-section">
						<h2>{{ concepts.hebergement_web.label }}</h2>
						<p class="section-description">{{ concepts.hebergement_web.description }}</p>

						<div class="hosting-comparison">
							<div class="hosting-card shared">
								<div class="hosting-icon">🏠</div>
								<h4>Mutualisé</h4>
								<div class="hosting-price">3-10€/mois</div>
								<p>Partage un serveur avec d'autres sites</p>
								<div class="hosting-use">✓ Blogs, sites vitrines</div>
							</div>
							<div class="hosting-card vps">
								<div class="hosting-icon">🏢</div>
								<h4>VPS</h4>
								<div class="hosting-price">15-50€/mois</div>
								<p>Votre espace virtuel garanti</p>
								<div class="hosting-use">✓ PME, e-commerce</div>
							</div>
							<div class="hosting-card dedicated">
								<div class="hosting-icon">🏰</div>
								<h4>Dédié</h4>
								<div class="hosting-price">100-500€/mois</div>
								<p>Serveur physique rien qu'à vous</p>
								<div class="hosting-use">✓ Gros projets</div>
							</div>
							<div class="hosting-card cloud">
								<div class="hosting-icon">☁️</div>
								<h4>Cloud</h4>
								<div class="hosting-price">Variable</div>
								<p>Ressources à la demande</p>
								<div class="hosting-use">✓ Startups, scalabilité</div>
							</div>
						</div>

						{% if concepts.hebergement_web.analogie is defined %}
							<div class="analogy-box">
								<div class="analogy-icon">💡</div>
								<div class="analogy-content">
									<strong>Analogie pour comprendre :</strong>
									<p>{{ concepts.hebergement_web.analogie }}</p>
								</div>
							</div>
						{% endif %}
					</section>
				{% endif %}

				<!-- Section Concepts détaillés -->
				<section class="detailed-concepts">
					<h2>Concepts Approfondis</h2>
					<div class="concepts-grid">
						{% for key, concept in concepts %}
							{% if key not in ['architecture_client_serveur', 'pile_lamp_lemp', 'cycle_requete_reponse', 'role_de_php', 'frontend_vs_backend', 'hebergement_web'] %}
								<div class="concept-card advanced-concept">
									<h3>{{ concept.label }}</h3>
									<p class="concept-description">{{ concept.description }}</p>

									{# Analogie en haut de la carte #}
									{% if concept.analogie is defined %}
										<div class="concept-analogy">
											<span class="analogy-label">💡 Analogie :</span>
											<span>{{ concept.analogie }}</span>
										</div>
									{% endif %}

									<div class="concept-details">
										{% for detail, description in concept.details %}
											<div class="detail-item">
												<strong>{{ detail }}:</strong>
												<span>{{ description }}</span>
											</div>
										{% endfor %}
									</div>

									{# Informations supplémentaires #}
									{% if concept.variantes is defined %}
										<div class="concept-extra">
											<strong>Variantes :</strong>
											{% for nom, desc in concept.variantes %}
												<span class="variant-badge">{{ nom }}:
													{{ desc }}</span>
											{% endfor %}
										</div>
									{% endif %}

									{% if concept.attaques_courantes is defined %}
										<div class="concept-extra danger">
											<strong>⚠️ Attaques courantes :</strong>
											{% for nom, desc in concept.attaques_courantes %}
												<span class="attack-badge">{{ nom }}:
													{{ desc }}</span>
											{% endfor %}
										</div>
									{% endif %}

									{% if concept.metriques is defined %}
										<div class="concept-extra metrics">
											<strong>📊 Métriques clés :</strong>
											{% for nom, desc in concept.metriques %}
												<span class="metric-badge">{{ nom }}:
													{{ desc }}</span>
											{% endfor %}
										</div>
									{% endif %}
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</section>

				<!-- Section Outils -->
				<section class="tools-section">
					<h2>Outils et Technologies</h2>
					<div class="tools-grid">
						{% for category, toolList in tools %}
							<div class="tool-category">
								<h3>
									{% if 'serveur' in category %}🌐{% elseif 'base' in category %}🗄️{% elseif 'monitoring' in category %}📊{% else %}🛠️
									{% endif %}
									{{ category|replace({'_': ' '})|title }}
								</h3>
								<div class="tools-list">
									{% for tool, description in toolList %}
										<div class="tool-item">
											<div class="tool-name">{{ tool }}</div>
											<div class="tool-description">{{ description }}</div>
										</div>
									{% endfor %}
								</div>
							</div>
						{% endfor %}
					</div>
				</section>

				<!-- Call to action -->
				<section class="cta-section">
					<div class="cta-content">
						<h2>Prêt à maîtriser PHP ?</h2>
						<p>Maintenant que vous comprenez l'infrastructure, explorez les modules pratiques !</p>
						<div class="cta-buttons">
							<a href="{{ path('app_poo') }}" class="cta-btn primary">Programmation Orientée Objet</a>
							<a href="{{ path('app_bdd') }}" class="cta-btn secondary">Bases de Données</a>
							<a href="{{ path('app_glossaire') }}" class="cta-btn tertiary">Glossaire</a>
						</div>
					</div>
				</section>
			</div>
		</main>
	</div>

	<style>
		/* ===== ANIMATIONS KEYFRAMES ===== */
		@keyframes pulse {
			0,
			100% {
				transform: scale(1);
			}
			50% {
				transform: scale(1.05);
			}
		}

		@keyframes slideInLeft {
			from {
				transform: translateX(-100%);
				opacity: 0;
			}
			to {
				transform: translateX(0);
				opacity: 1;
			}
		}

		@keyframes slideInRight {
			from {
				transform: translateX(100%);
				opacity: 0;
			}
			to {
				transform: translateX(0);
				opacity: 1;
			}
		}

		@keyframes slideInUp {
			from {
				transform: translateY(50px);
				opacity: 0;
			}
			to {
				transform: translateY(0);
				opacity: 1;
			}
		}

		@keyframes flowRight {
			0% {
				transform: translateX(-10px);
				opacity: 0.5;
			}
			50% {
				transform: translateX(5px);
				opacity: 1;
			}
			100% {
				transform: translateX(-10px);
				opacity: 0.5;
			}
		}

		@keyframes flowLeft {
			0% {
				transform: translateX(10px);
				opacity: 0.5;
			}
			50% {
				transform: translateX(-5px);
				opacity: 1;
			}
			100% {
				transform: translateX(10px);
				opacity: 0.5;
			}
		}

		@keyframes stackGlow {
			0,
			100% {
				box-shadow: 0 4px 20px rgba(255, 107, 53, 0.2);
			}
			50% {
				box-shadow: 0 8px 40px rgba(255, 107, 53, 0.4);
			}
		}

		@keyframes dataFlow {
			0% {
				transform: translateX(-20px) scale(0.8);
				opacity: 0;
			}
			50% {
				transform: translateX(0) scale(1);
				opacity: 1;
			}
			100% {
				transform: translateX(20px) scale(0.8);
				opacity: 0;
			}
		}

		@keyframes bounce {
			0,
			20%,
			53%,
			80%,
			100% {
				transform: translate3d(0, 0, 0);
			}
			40%,
			43% {
				transform: translate3d(0, -15px, 0);
			}
			70% {
				transform: translate3d(0, -8px, 0);
			}
			90% {
				transform: translate3d(0, -3px, 0);
			}
		}

		@keyframes rotate {
			from {
				transform: rotate(0deg);
			}
			to {
				transform: rotate(360deg);
			}
		}

		@keyframes fadeInScale {
			from {
				transform: scale(0.8);
				opacity: 0;
			}
			to {
				transform: scale(1);
				opacity: 1;
			}
		}

		/* ===== STYLES DE BASE ===== */
		/* Styles spécifiques au module Infrastructure */
		.infrastructure-page {
			--infra-primary: #ff6b35;
			--infra-secondary: #f7931e;
			--infra-accent: #ffb347;
			--infra-gradient: linear-gradient(135deg, var(--infra-primary), var(--infra-secondary));
		}

		.infrastructure-header {
			background: var(--infra-gradient);
			color: white;
			padding: 2rem 0;
			margin-bottom: 2rem;
			position: relative;
			animation: slideInUp 1s ease-out;
		}

		.concept-section {
			margin: 3rem 0;
			animation: fadeInScale 1.2s ease-out;
			opacity: 0;
			animation-fill-mode: forwards;
		}

		.concept-section:nth-child(1) {
			animation-delay: 0.2s;
		}
		.concept-section:nth-child(2) {
			animation-delay: 0.4s;
		}
		.concept-section:nth-child(3) {
			animation-delay: 0.6s;
		}
		.concept-section:nth-child(4) {
			animation-delay: 0.8s;
		}

		.concept-section h2 {
			animation: slideInLeft 1s ease-out;
		}

		.section-description {
			animation: slideInRight 1s ease-out 0.3s;
			opacity: 0;
			animation-fill-mode: forwards;
		}
		overflow: hidden;
	}

	.infrastructure-header::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: url('data:image/svg+xml, <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255, 255, 255, 0.1)"/><circle cx="80" cy="80" r="3" fill="rgba(255, 255, 255, 0.1)"/><circle cx="40" cy="60" r="1" fill="rgba(255, 255, 255, 0.1)"/></svg>');
		animation: float 20s infinite linear;
	}

	.page-title {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.page-title .icon {
		font-size: 3rem;
		animation: pulse 2s infinite;
	}

	.quick-nav {
		background: rgba(255, 107, 53, 0.1);
		padding: 1rem 0;
		margin-bottom: 2rem;
		border-top: 2px solid var(--infra-primary);
		border-bottom: 2px solid var(--infra-primary);
	}

	.nav-pills {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.nav-pill {
		padding: 0.5rem 1rem;
		background: var(--infra-gradient);
		color: white;
		text-decoration: none;
		border-radius: 25px;
		transition: all 0.3s ease;
		font-weight: 500;
		animation: slideInUp 0.8s ease-out;
		transform: translateY(0);
	}

	.nav-pill:nth-child(1) {
		animation-delay: 0.1s;
	}
	.nav-pill:nth-child(2) {
		animation-delay: 0.2s;
	}
	.nav-pill:nth-child(3) {
		animation-delay: 0.3s;
	}
	.nav-pill:nth-child(4) {
		animation-delay: 0.4s;
	}
	.nav-pill:nth-child(5) {
		animation-delay: 0.5s;
	}

	.nav-pill:hover {
		background: linear-gradient(135deg, var(--infra-secondary), var(--infra-primary));
		transform: translateY(-3px) scale(1.05);
		box-shadow: 0 8px 25px rgba(255, 107, 53, 0.4);
		animation: bounce 0.6s ease-in-out;
	}

	.nav-pill:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 15px rgba(255, 107, 53, 0.4);
	}

	/* Diagramme Client-Serveur */
	.client-server-diagram {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 2rem;
		align-items: center;
		padding: 2rem;
		background: linear-gradient(135deg, #f8f9fa, #e9ecef);
		border-radius: 15px;
		margin: 2rem 0;
		animation: fadeInScale 1s ease-out;
	}

	.client-box {
		background: white;
		padding: 1.5rem;
		border-radius: 10px;
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
		text-align: center;
		border: 3px solid var(--infra-primary);
		animation: slideInLeft 1.2s ease-out;
		transition: all 0.3s ease;
	}

	.server-box {
		background: white;
		padding: 1.5rem;
		border-radius: 10px;
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
		text-align: center;
		border: 3px solid var(--infra-primary);
		animation: slideInRight 1.2s ease-out;
		transition: all 0.3s ease;
	}

	.client-box:hover,
	.server-box:hover {
		transform: translateY(-10px);
		box-shadow: 0 15px 40px rgba(255, 107, 53, 0.3);
	}

	.browser-icon,
	.server-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		display: block;
		animation: bounce 2s infinite;
	}

	.browser-icon:hover,
	.server-icon:hover {
		animation: rotate 0.5s ease-in-out;
	}

	.communication-flow {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		animation: slideInUp 1.5s ease-out;
	}

	.request-arrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		animation: flowRight 3s infinite;
	}

	.response-arrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		animation: flowLeft 3s infinite 1.5s;
	}

	.arrow {
		font-size: 1.5rem;
		color: var(--infra-primary);
		font-weight: bold;
		filter: drop-shadow(0 0 5px rgba(255, 107, 53, 0.5));
	}

	.arrow-label {
		background: var(--infra-primary);
		color: white;
		padding: 0.25rem 0.5rem;
		border-radius: 5px;
		font-size: 0.8rem;
		font-weight: bold;
		animation: pulse 2s infinite;
		box-shadow: 0 2px 10px rgba(255, 107, 53, 0.3);
	}

	/* Diagramme Pile LAMP */
	.lamp-stack-diagram {
		display: flex;
		flex-direction: column-reverse;
		gap: 1rem;
		max-width: 600px;
		margin: 2rem auto;
		animation: fadeInScale 1.5s ease-out;
	}

	.stack-layer {
		background: white;
		padding: 1.5rem;
		border-radius: 10px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
		border-left: 5px solid var(--infra-primary);
		transition: all 0.3s ease;
		animation: slideInUp 0.8s ease-out;
	}

	.stack-layer:nth-child(1) {
		animation-delay: 0.1s;
	}
	.stack-layer:nth-child(2) {
		animation-delay: 0.2s;
	}
	.stack-layer:nth-child(3) {
		animation-delay: 0.3s;
	}
	.stack-layer:nth-child(4) {
		animation-delay: 0.4s;
	}

	.stack-layer:hover {
		transform: translateX(10px) scale(1.02);
		box-shadow: 0 8px 30px rgba(255, 107, 53, 0.2);
		animation: stackGlow 2s infinite;
	}

	.layer-icon {
		font-size: 2rem;
		margin-bottom: 0.5rem;
		display: inline-block;
		animation: bounce 2s infinite;
	}

	.layer-icon:hover {
		animation: rotate 0.8s ease-in-out;
	}
	display: flex;
	align-items: center;
	gap: 1rem;
	padding: 1.5rem;
	border-radius: 10px;
	transition: all 0.3s ease;
	cursor: pointer;
}

.os-layer {
	background: linear-gradient(135deg, #28a745, #20c997);
	color: white;
}
.web-server-layer {
	background: linear-gradient(135deg, #17a2b8, #6f42c1);
	color: white;
}
.database-layer {
	background: linear-gradient(135deg, #ffc107, #fd7e14);
	color: white;
}
.php-layer {
	background: linear-gradient(135deg, #6f42c1, #e83e8c);
	color: white;
}

.stack-layer:hover {
	transform: translateX(10px);
	box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
}

.layer-icon {
	font-size: 2.5rem;
	opacity: 0.9;
}

.layer-content h3 {
	margin: 0 0 0.25rem;
	font-size: 1.2rem;
}

.layer-content p {
	margin: 0 0 0.25rem;
	opacity: 0.9;
}

.layer-description {
	font-size: 0.8rem;
	opacity: 0.8;
}

/* Diagramme Cycle HTTP */
.http-cycle-diagram {
	display: flex;
	align-items: center;
	gap: 1rem;
	padding: 2rem;
	background: linear-gradient(135deg, #f8f9fa, #dee2e6);
	border-radius: 15px;
	overflow-x: auto;
	margin: 2rem 0;
	animation: fadeInScale 1.5s ease-out;
}

.cycle-step {
	background: white;
	padding: 1.5rem;
	border-radius: 10px;
	min-width: 200px;
	text-align: center;
	box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
	position: relative;
	transition: all 0.3s ease;
	animation: slideInUp 1s ease-out;
}

.cycle-step:nth-child(1) {
	animation-delay: 0.1s;
}
.cycle-step:nth-child(2) {
	animation-delay: 0.3s;
}
.cycle-step:nth-child(3) {
	animation-delay: 0.5s;
}
.cycle-step:nth-child(4) {
	animation-delay: 0.7s;
}
.cycle-step:nth-child(5) {
	animation-delay: 0.9s;
}

.cycle-step:hover {
	transform: translateY(-10px) scale(1.05);
	box-shadow: 0 12px 40px rgba(255, 107, 53, 0.3);
	z-index: 10;
}

.step-number {
	position: absolute;
	top: -15px;
	left: 50%;
	transform: translateX(-50%);
	background: var(--infra-primary);
	color: white;
	width: 30px;
	height: 30px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-weight: bold;
	animation: pulse 2s infinite;
	box-shadow: 0 4px 15px rgba(255, 107, 53, 0.4);
}
display: flex;
align-items: center;
justify-content: center;
font-weight: bold;
}

.cycle-step h4 {
margin: 1rem 0 0.5rem;
color: var(--infra-primary);
}

.cycle-step code {
background: #f8f9fa;
padding: 0.5rem;
border-radius: 5px;
display: block;
font-size: 0.8rem;
margin-top: 0.5rem;
}

.cycle-arrow {
font-size: 1.5rem;
color: var(--infra-primary);
font-weight: bold;
animation: dataFlow 2s infinite;
filter: drop-shadow(0 0 8px rgba(255, 107, 53, 0.6));
}

.cycle-arrow:nth-of-type(2) {
animation-delay: 0.5s;
}
.cycle-arrow:nth-of-type(3) {
animation-delay: 1s;
}
.cycle-arrow:nth-of-type(4) {
animation-delay: 1.5s;
}

/* Grille des rôles PHP */
.php-role-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
gap: 1.5rem;
margin: 2rem 0;
}

.role-card {
