}
.tool-category:nth-child(2) {
animation-delay: 0.4s;
}
.tool-category:nth-child(3) {
animation-delay: 0.6s;
}
.tool-category:nth-child(4) {
animation-delay: 0.8s;
}

.tool-category:hover {
