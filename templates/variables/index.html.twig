{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Variables
{% endblock %}

{% block body %}
	<!-- Header spécifique aux variables -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// VARIABLES PHP</h1>
				<p class="header-subtitle">
					Maîtrisez les fondamentaux des variables en PHP : déclaration, portée, affectation et bonnes pratiques.
										Chaque concept vous rapproche de la maîtrise du développement PHP.
				</p>
			</div>
		</div>
	</header>

	<!-- Contenu principal - Variables de base -->
	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Variables - Concepts fondamentaux</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% include 'components/card.html.twig' with {
						'title': key|replace({'_': ' '})|title,
						'description': concept.description,
						'icon': '💾',
						'modalId': 'modal-' ~ key
					} %}
				{% endfor %}
			</div>

			<!-- Section Variables superglobales -->
			<h2 class="section-title">Variables superglobales PHP</h2>
			<div class="grid">
				{% for key, concept in dataGlobales %}
					{% include 'components/card.html.twig' with {
						'title': key,
						'description': concept.description,
						'icon': '🌐',
						'modalId': 'modal-global_' ~ key|replace({'$': '', '_': ''})
					} %}
				{% endfor %}
			</div>
		</div>
	</main>

	<!-- Modales pour les concepts de base -->
	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
			'id': 'modal-' ~ key,
			'title': key|replace({'_': ' '})|title,
			'icon': '💾',
			'description': concept.description,
			'details': concept.details ?? null,
			'example': concept.example ?? null,
			'useCases': concept.useCases ?? null,
			'warnings': concept.warnings ?? null,
			'bestPractices': concept.bestPractices ?? null,
			'resources': concept.resources ?? null,
			'relatedTopics': concept.relatedTopics ?? null
		} %}
	{% endfor %}

	<!-- Modales pour les variables superglobales -->
	{% for key, concept in dataGlobales %}
		{% include 'components/modal.html.twig' with {
			'id': 'modal-global_' ~ key|replace({'$': '', '_': ''}),
			'title': key,
			'icon': '🌐',
			'description': concept.description,
			'details': concept.details ?? null,
			'example': concept.example ?? null,
			'useCases': concept.useCases ?? null,
			'warnings': concept.warnings ?? null,
			'bestPractices': concept.bestPractices ?? null,
			'resources': concept.resources ?? null,
			'relatedTopics': concept.relatedTopics ?? null
		} %}
	{% endfor %}

	<!-- Effet Matrix de fond -->
	<div class="matrix-bg" id="matrix-canvas"></div>

	<style>
		/* Styles spécifiques à la page Variables */
		.section-title {
			color: var(--matrix-green);
			font-size: 2rem;
			margin: 3rem 0 2rem;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 2px;
			border-bottom: 2px solid var(--matrix-green);
			padding-bottom: 1rem;
		}

		/* Responsiveness améliorée */
		@media(max-width: 768px) {
			.section-title {
				font-size: 1.5rem;
			}
		}
	</style>
{% endblock %}
