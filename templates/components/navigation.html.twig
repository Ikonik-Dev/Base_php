{# Composant de navigation #}
<nav class="navbar">
	<div class="container">
		<div class="navbar-container">
			<div class="navbar-brand">
				&lt;/&gt; Cours PHP
			</div>
			<ul class="navbar-nav">
				{% if data is defined %}
					{% for key, concept in data %}
						<li>
							<a href="#{{ key }}" class="nav-link">{{ key|replace({'_': ' '})|title }}</a>
						</li>
					{% endfor %}
				{% else %}
					{# Navigation par défaut si pas de data #}
					<li>
						<a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
					</li>
					<li>
						<a href="{{ path('app_variables') }}" class="nav-link">Variables</a>
					</li>
					<li>
						<a href="{{ path('app_poo') }}" class="nav-link">POO</a>
					</li>
					<li>
						<a href="{{ path('app_bdd') }}" class="nav-link">Bases de données</a>
					</li>
					<li>
						<a href="{{ path('app_infrastructure') }}" class="nav-link">Infrastructure Web</a>
					</li>
					<li>
						<a href="{{ path('app_glossaire') }}" class="nav-link">Glossaire</a>
					</li>
				{% endif %}
			</ul>
		</div>
	</div>
</nav>
