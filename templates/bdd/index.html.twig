			padding: 0.5rem 1rem;
			border-radius: 20px;
			font-weight: bold;
			font-size: 0.85rem;
			display: inline-block;
			margin-bottom: 0.5rem;
		}

		.join-on {
			font-family: monospace;
			font-size: 0.75rem;
			color: rgba(255, 255, 255, 0.6);
			margin-bottom: 0.5rem;
		}

		.join-arrows {
			font-size: 2rem;
			color: #00ff41;
		}

		.join-result {
			margin-top: 1.5rem;
