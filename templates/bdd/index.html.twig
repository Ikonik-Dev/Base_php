		.flow-step.query {
			background: rgba(0, 255, 65, 0.2);
			border: 2px solid #00ff41;
			color: #00ff41;
		}

		.flow-step.commit {
			background: #28a745;
			color: #fff;
		}

		.flow-step.rollback {
			background: #dc3545;
			color: #fff;
		}

		.flow-arrow {
			color: rgba(255, 255, 255, 0.5);
			font-size: 1.5rem;
		}

		.flow-step-group {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
		}

		.flow-or {
			color: rgba(255, 255, 255, 0.5);
			font-size: 0.8rem;
		}

		/* === Injection SQL Comparison === */
		.injection-comparison {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			gap: 1.5rem;
			align-items: stretch;
			max-width: 1000px;
			margin: 0 auto;
		}

		.injection-side {
			padding: 1.5rem;
			border-radius: 12px;
			background: rgba(0, 0, 0, 0.3);
