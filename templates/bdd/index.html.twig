		/* === CRUD Diagram === */
		.crud-diagram {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1.5rem;
			max-width: 900px;
			margin: 0 auto;
		}

		.crud-operation {
			text-align: center;
			padding: 1.5rem;
			border-radius: 12px;
			background: rgba(0, 0, 0, 0.3);
			border: 2px solid;
			transition: all 0.3s ease;
		}

		.crud-operation:hover {
			transform: translateY(-5px);
		}

		.crud-operation.create {
			border-color: #28a745;
		}

		.crud-operation.read {
			border-color: #17a2b8;
		}

		.crud-operation.update {
			border-color: #ffc107;
		}

		.crud-operation.delete {
			border-color: #dc3545;
