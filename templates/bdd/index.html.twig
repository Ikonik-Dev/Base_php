		.result-header {
			display: flex;
			gap: 2rem;
			padding: 0.5rem 1rem;
			background: rgba(0, 255, 65, 0.2);
			font-weight: bold;
			color: #00ff41;
		}

		.result-row {
			padding: 0.5rem 1rem;
			color: rgba(255, 255, 255, 0.8);
			border-top: 1px solid rgba(255, 255, 255, 0.1);
		}

		.join-types-legend {
			display: flex;
			justify-content: center;
			gap: 1.5rem;
			margin-top: 1.5rem;
			flex-wrap: wrap;
