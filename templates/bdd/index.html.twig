{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Interaction Avec Les Bases De Données
{% endblock %}

{% block body %}
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// BASES DE DONNÉES & PHP</h1>
				<p class="header-subtitle">
					Maîtrisez l'interaction avec les bases de données : PDO, requêtes sécurisées, transactions et optimisations.
					De la connexion simple aux techniques avancées comme Doctrine ORM.
				</p>
			</div>
		</div>
	</header>

	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Introduction & Connexion</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-introduction_bdd',
'title': 'Introduction BDD',
'description': data.introduction_bdd.description,
'example': data.introduction_bdd.example,
'iconClass': 'fa-solid fa-database'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-pdo_introduction',
'title': 'PDO Introduction',
'description': data.pdo_introduction.description,
'example': data.pdo_introduction.example,
'iconClass': 'fa-solid fa-plug'
} %}
			</div>

			<h2 class="section-title">Requêtes & Sécurité</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-requetes_select',
'title': 'Requêtes SELECT',
'description': data.requetes_select.description,
'example': data.requetes_select.example,
'iconClass': 'fa-solid fa-magnifying-glass'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-requetes_preparees',
'title': 'Requêtes Préparées',
'description': data.requetes_preparees.description,
'example': data.requetes_preparees.example,
'iconClass': 'fa-solid fa-shield-halved'
} %}
			</div>

			<h2 class="section-title">Manipulation Données (CRUD)</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-insertion_donnees',
'title': 'Insertion Données',
'description': data.insertion_donnees.description,
'example': data.insertion_donnees.example,
'iconClass': 'fa-solid fa-plus'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-mise_a_jour_donnees',
'title': 'Mise À Jour',
'description': data.mise_a_jour_donnees.description,
'example': data.mise_a_jour_donnees.example,
'iconClass': 'fa-solid fa-pen-to-square'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-suppression_donnees',
'title': 'Suppression Données',
'description': data.suppression_donnees.description,
'example': data.suppression_donnees.example,
'iconClass': 'fa-solid fa-trash'
} %}
			</div>

			<h2 class="section-title">Transactions & Jointures</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-transactions',
'title': 'Transactions',
'description': data.transactions.description,
'example': data.transactions.example,
'iconClass': 'fa-solid fa-arrows-rotate'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-jointures',
'title': 'Jointures',
'description': data.jointures.description,
'example': data.jointures.example,
'iconClass': 'fa-solid fa-link'
} %}
			</div>

			<h2 class="section-title">Gestion Erreurs & Outils Avancés</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-gestion_erreurs',
'title': 'Gestion Erreurs',
'description': data.gestion_erreurs.description,
'example': data.gestion_erreurs.example,
'iconClass': 'fa-solid fa-triangle-exclamation'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-orm_doctrine',
'title': 'ORM Doctrine',
'description': data.orm_doctrine.description,
'example': data.orm_doctrine.example,
'iconClass': 'fa-solid fa-cubes'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-migrations',
'title': 'Migrations',
'description': data.migrations.description,
'example': data.migrations.example,
'iconClass': 'fa-solid fa-code-branch'
} %}
			</div>

			<h2 class="section-title">Performance & Sécurité</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-optimisation_requetes',
'title': 'Optimisation Requêtes',
'description': data.optimisation_requetes.description,
'example': data.optimisation_requetes.example,
'iconClass': 'fa-solid fa-gauge-high'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-securite_bdd',
'title': 'Sécurité BDD',
'description': data.securite_bdd.description,
'example': data.securite_bdd.example,
'iconClass': 'fa-solid fa-lock'
} %}
			</div>
		</div>
	</main>

	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
'id': 'modal-' ~ key,
'title': key|replace({'_': ' '})|title,
'description': concept.description,
'example': concept.example,
'details': concept.details|default(null),
'useCases': concept.useCases|default([]),
'warnings': concept.warnings|default([]),
'bestPractices': concept.bestPractices|default([]),
'resources': concept.resources|default([]),
'relatedTopics': concept.relatedTopics|default([])
} %}
	{% endfor %}

	<div class="matrix-bg" id="matrix-canvas"></div>
{% endblock %}
