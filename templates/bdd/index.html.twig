{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Interaction Avec Les Bases De Données
{% endblock %}

{% block body %}
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// BASES DE DONNÉES & PHP</h1>
				<p class="header-subtitle">
					Maîtrisez l'interaction avec les bases de données : PDO, requêtes sécurisées, transactions et optimisations.
					De la connexion simple aux techniques avancées comme Doctrine ORM.
				</p>
			</div>
		</div>
	</header>

	<main class="main-content">
		<div class="container">

			{# ===== SCHÉMA 1 : Architecture PHP-BDD ===== #}
			<section class="diagram-section">
				<h2 class="diagram-title">🏗️ Architecture PHP ↔ Base de Données</h2>
				<p class="diagram-description">Comment PHP communique avec MySQL via PDO</p>
				
				<div class="php-bdd-diagram">
					<div class="diagram-layer app-layer">
						<div class="layer-icon">📱</div>
						<div class="layer-content">
							<h4>Application PHP</h4>
							<p>Votre code</p>
							<code>$pdo->query(...)</code>
						</div>
					</div>
					
					<div class="diagram-arrow">⬇️ Requête SQL</div>
					
					<div class="diagram-layer pdo-layer">
						<div class="layer-icon">🔌</div>
						<div class="layer-content">
							<h4>PDO (PHP Data Objects)</h4>
							<p>Couche d'abstraction</p>
							<code>prepare() → execute() → fetch()</code>
						</div>
					</div>
					
					<div class="diagram-arrow">⬇️ Protocole MySQL</div>
					
					<div class="diagram-layer db-layer">
						<div class="layer-icon">🗄️</div>
						<div class="layer-content">
							<h4>MySQL / MariaDB</h4>
							<p>Serveur de base de données</p>
							<code>Tables, Index, Données</code>
						</div>
					</div>
				</div>

				<div class="diagram-legend">
					<div class="legend-item">
						<span class="legend-color app"></span>
						<span>Code PHP (vous écrivez ici)</span>
					</div>
					<div class="legend-item">
						<span class="legend-color pdo"></span>
						<span>PDO traduit PHP → SQL</span>
					</div>
					<div class="legend-item">
						<span class="legend-color db"></span>
						<span>MySQL stocke les données</span>
					</div>
				</div>
			</section>

			<h2 class="section-title">Introduction & Connexion</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-introduction_bdd',
'title': 'Introduction BDD',
'description': data.introduction_bdd.description,
'example': data.introduction_bdd.example,
'iconClass': 'fa-solid fa-database'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-pdo_introduction',
'title': 'PDO Introduction',
'description': data.pdo_introduction.description,
'example': data.pdo_introduction.example,
'iconClass': 'fa-solid fa-plug'
} %}
			</div>

			{# ===== SCHÉMA 2 : Structure d'une Table ===== #}
			<section class="diagram-section">
				<h2 class="diagram-title">📊 Structure d'une Table SQL</h2>
				<p class="diagram-description">Une table = un tableau avec colonnes (champs) et lignes (enregistrements)</p>
				
				<div class="table-structure-diagram">
					<div class="sql-table">
						<div class="table-name">📋 Table : users</div>
						<div class="table-header">
							<div class="col col-id">id</div>
							<div class="col col-name">nom</div>
							<div class="col col-email">email</div>
							<div class="col col-date">created_at</div>
						</div>
						<div class="table-row">
							<div class="cell cell-id">1</div>
							<div class="cell">Alice</div>
							<div class="cell">alice@mail.com</div>
							<div class="cell">2024-01-15</div>
						</div>
						<div class="table-row">
							<div class="cell cell-id">2</div>
							<div class="cell">Bob</div>
							<div class="cell">bob@mail.com</div>
							<div class="cell">2024-02-20</div>
						</div>
						<div class="table-row highlight">
							<div class="cell cell-id">3</div>
							<div class="cell">Charlie</div>
							<div class="cell">charlie@mail.com</div>
							<div class="cell">2024-03-10</div>
						</div>
					</div>
					
					<div class="table-annotations">
						<div class="annotation pk">
							<span class="annotation-arrow">←</span>
							<span class="annotation-text"><strong>Clé Primaire (PK)</strong><br>Identifiant unique, auto-incrémenté</span>
						</div>
						<div class="annotation row">
							<span class="annotation-arrow">←</span>
							<span class="annotation-text"><strong>Ligne = Enregistrement</strong><br>Une entrée dans la table</span>
						</div>
					</div>
				</div>
			</section>

			<h2 class="section-title">Requêtes & Sécurité</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-requetes_select',
'title': 'Requêtes SELECT',
'description': data.requetes_select.description,
'example': data.requetes_select.example,
'iconClass': 'fa-solid fa-magnifying-glass'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-requetes_preparees',
'title': 'Requêtes Préparées',
'description': data.requetes_preparees.description,
'example': data.requetes_preparees.example,
'iconClass': 'fa-solid fa-shield-halved'
} %}
			</div>

			{# ===== SCHÉMA 3 : CRUD Operations ===== #}
			<section class="diagram-section">
				<h2 class="diagram-title">🔄 Les 4 Opérations CRUD</h2>
				<p class="diagram-description">Create, Read, Update, Delete - les actions de base sur les données</p>
				
				<div class="crud-diagram">
					<div class="crud-operation create">
						<div class="crud-icon">➕</div>
						<div class="crud-letter">C</div>
						<div class="crud-name">CREATE</div>
						<div class="crud-sql">INSERT INTO</div>
						<div class="crud-desc">Ajouter une nouvelle ligne</div>
					</div>
					
					<div class="crud-operation read">
						<div class="crud-icon">👁️</div>
						<div class="crud-letter">R</div>
						<div class="crud-name">READ</div>
						<div class="crud-sql">SELECT</div>
						<div class="crud-desc">Lire/Récupérer des données</div>
					</div>
					
					<div class="crud-operation update">
						<div class="crud-icon">✏️</div>
						<div class="crud-letter">U</div>
						<div class="crud-name">UPDATE</div>
						<div class="crud-sql">UPDATE ... SET</div>
						<div class="crud-desc">Modifier une ligne existante</div>
					</div>
					
					<div class="crud-operation delete">
						<div class="crud-icon">🗑️</div>
						<div class="crud-letter">D</div>
						<div class="crud-name">DELETE</div>
						<div class="crud-sql">DELETE FROM</div>
						<div class="crud-desc">Supprimer une ligne</div>
					</div>
				</div>
			</section>

			<h2 class="section-title">Manipulation Données (CRUD)</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-insertion_donnees',
'title': 'Insertion Données',
'description': data.insertion_donnees.description,
'example': data.insertion_donnees.example,
'iconClass': 'fa-solid fa-plus'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-mise_a_jour_donnees',
'title': 'Mise À Jour',
'description': data.mise_a_jour_donnees.description,
'example': data.mise_a_jour_donnees.example,
'iconClass': 'fa-solid fa-pen-to-square'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-suppression_donnees',
'title': 'Suppression Données',
'description': data.suppression_donnees.description,
'example': data.suppression_donnees.example,
'iconClass': 'fa-solid fa-trash'
} %}
			</div>

			{# ===== SCHÉMA 4 : Jointures SQL ===== #}
			<section class="diagram-section">
				<h2 class="diagram-title">🔗 Les Jointures SQL (JOIN)</h2>
				<p class="diagram-description">Relier plusieurs tables entre elles grâce aux clés</p>
				
				<div class="join-diagram">
					<div class="join-tables">
						<div class="join-table table-left">
							<div class="join-table-name">users</div>
							<div class="join-table-cols">
								<span class="pk">id</span>
								<span>nom</span>
							</div>
							<div class="join-table-data">
								<div>1 | Alice</div>
								<div>2 | Bob</div>
							</div>
						</div>
						
						<div class="join-connector">
							<div class="join-type">INNER JOIN</div>
							<div class="join-on">ON users.id = orders.user_id</div>
							<div class="join-arrows">
								<span>←→</span>
							</div>
						</div>
						
						<div class="join-table table-right">
							<div class="join-table-name">orders</div>
							<div class="join-table-cols">
								<span class="pk">id</span>
								<span class="fk">user_id</span>
								<span>total</span>
							</div>
							<div class="join-table-data">
								<div>1 | 1 | 99€</div>
								<div>2 | 1 | 150€</div>
								<div>3 | 2 | 75€</div>
							</div>
						</div>
					</div>
					
					<div class="join-result">
						<div class="join-result-title">📋 Résultat du JOIN</div>
						<div class="join-result-table">
							<div class="result-header">
								<span>nom</span>
								<span>total</span>
							</div>
							<div class="result-row">Alice | 99€</div>
							<div class="result-row">Alice | 150€</div>
							<div class="result-row">Bob | 75€</div>
						</div>
					</div>
				</div>
				
				<div class="join-types-legend">
					<div class="join-type-item inner">
						<strong>INNER JOIN</strong> : Uniquement les correspondances
					</div>
					<div class="join-type-item left">
						<strong>LEFT JOIN</strong> : Tout à gauche + correspondances
					</div>
					<div class="join-type-item right">
						<strong>RIGHT JOIN</strong> : Tout à droite + correspondances
					</div>
				</div>
			</section>

			<h2 class="section-title">Transactions & Jointures</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-transactions',
'title': 'Transactions',
'description': data.transactions.description,
'example': data.transactions.example,
'iconClass': 'fa-solid fa-arrows-rotate'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-jointures',
'title': 'Jointures',
'description': data.jointures.description,
'example': data.jointures.example,
'iconClass': 'fa-solid fa-link'
} %}
			</div>

			{# ===== SCHÉMA 5 : Transaction ACID ===== #}
			<section class="diagram-section">
				<h2 class="diagram-title">🔐 Transactions : Le Principe ACID</h2>
				<p class="diagram-description">Les 4 garanties d'une transaction fiable</p>
				
				<div class="acid-diagram">
					<div class="acid-property atomicity">
						<div class="acid-letter">A</div>
						<div class="acid-name">Atomicité</div>
						<div class="acid-desc">Tout ou rien : si une étape échoue, tout est annulé</div>
						<div class="acid-example">❌ Paiement échoue → commande annulée</div>
					</div>
					
					<div class="acid-property consistency">
						<div class="acid-letter">C</div>
						<div class="acid-name">Cohérence</div>
						<div class="acid-desc">La BDD reste dans un état valide après chaque transaction</div>
						<div class="acid-example">✅ Stock jamais négatif</div>
					</div>
					
					<div class="acid-property isolation">
						<div class="acid-letter">I</div>
						<div class="acid-name">Isolation</div>
						<div class="acid-desc">Les transactions parallèles ne s'interfèrent pas</div>
						<div class="acid-example">👥 2 achats simultanés = pas de conflit</div>
					</div>
					
					<div class="acid-property durability">
						<div class="acid-letter">D</div>
						<div class="acid-name">Durabilité</div>
						<div class="acid-desc">Une fois validée, la transaction est permanente</div>
						<div class="acid-example">💾 Même si serveur crash après commit</div>
					</div>
				</div>
				
				<div class="transaction-flow">
					<div class="flow-step begin">BEGIN</div>
					<div class="flow-arrow">→</div>
					<div class="flow-step query">Requêtes SQL</div>
					<div class="flow-arrow">→</div>
					<div class="flow-step-group">
						<div class="flow-step commit">✅ COMMIT</div>
						<div class="flow-or">ou</div>
						<div class="flow-step rollback">❌ ROLLBACK</div>
					</div>
				</div>
			</section>

			<h2 class="section-title">Gestion Erreurs & Outils Avancés</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-gestion_erreurs',
'title': 'Gestion Erreurs',
'description': data.gestion_erreurs.description,
'example': data.gestion_erreurs.example,
'iconClass': 'fa-solid fa-triangle-exclamation'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-orm_doctrine',
'title': 'ORM Doctrine',
'description': data.orm_doctrine.description,
'example': data.orm_doctrine.example,
'iconClass': 'fa-solid fa-cubes'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-migrations',
'title': 'Migrations',
'description': data.migrations.description,
'example': data.migrations.example,
'iconClass': 'fa-solid fa-code-branch'
} %}
			</div>

			{# ===== SCHÉMA 6 : Injection SQL vs Requête Préparée ===== #}
			<section class="diagram-section">
				<h2 class="diagram-title">🛡️ Injection SQL : Danger & Protection</h2>
				<p class="diagram-description">Pourquoi les requêtes préparées sont essentielles</p>
				
				<div class="injection-comparison">
					<div class="injection-side danger">
						<div class="side-header">❌ DANGEREUX : Concaténation</div>
						<div class="side-code">
							<code>$sql = "SELECT * FROM users WHERE id = " . $_GET['id'];</code>
						</div>
						<div class="side-attack">
							<div class="attack-label">🏴‍☠️ Attaque :</div>
							<code>?id=1 OR 1=1 --</code>
						</div>
						<div class="side-result bad">
							<div class="result-label">Résultat :</div>
							<code>SELECT * FROM users WHERE id = 1 OR 1=1 --</code>
							<p>→ Retourne TOUS les utilisateurs ! 😱</p>
						</div>
					</div>
					
					<div class="vs-separator">VS</div>
					
					<div class="injection-side safe">
						<div class="side-header">✅ SÉCURISÉ : Requête préparée</div>
						<div class="side-code">
							<code>$stmt = $pdo->prepare("SELECT * FROM users WHERE id = ?");<br>$stmt->execute([$_GET['id']]);</code>
						</div>
						<div class="side-attack">
							<div class="attack-label">🏴‍☠️ Même attaque :</div>
							<code>?id=1 OR 1=1 --</code>
						</div>
						<div class="side-result good">
							<div class="result-label">Résultat :</div>
							<code>Cherche id = "1 OR 1=1 --" (texte littéral)</code>
							<p>→ Aucun résultat, attaque bloquée ! 🛡️</p>
						</div>
					</div>
				</div>
			</section>

			<h2 class="section-title">Performance & Sécurité</h2>
			<div class="grid">
				{% include 'components/card.html.twig' with {
'modalId': 'modal-optimisation_requetes',
'title': 'Optimisation Requêtes',
'description': data.optimisation_requetes.description,
'example': data.optimisation_requetes.example,
'iconClass': 'fa-solid fa-gauge-high'
} %}
				{% include 'components/card.html.twig' with {
'modalId': 'modal-securite_bdd',
'title': 'Sécurité BDD',
'description': data.securite_bdd.description,
'example': data.securite_bdd.example,
'iconClass': 'fa-solid fa-lock'
} %}
			</div>
		</div>
	</main>

	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
'id': 'modal-' ~ key,
'title': key|replace({'_': ' '})|title,
'description': concept.description,
'example': concept.example,
'details': concept.details|default(null),
'useCases': concept.useCases|default([]),
'warnings': concept.warnings|default([]),
'bestPractices': concept.bestPractices|default([]),
'resources': concept.resources|default([]),
'relatedTopics': concept.relatedTopics|default([])
} %}
	{% endfor %}

	<div class="matrix-bg" id="matrix-canvas"></div>

	<style>
		/* ===== STYLES DIAGRAMMES BDD ===== */
		.diagram-section {
			margin: 3rem 0;
			padding: 2rem;
			background: linear-gradient(135deg, rgba(0, 255, 65, 0.05), rgba(0, 200, 50, 0.02));
			border-radius: 15px;
			border: 1px solid rgba(0, 255, 65, 0.2);
		}

		.diagram-title {
			font-size: 1.5rem;
			color: #00ff41;
			margin-bottom: 0.5rem;
			text-align: center;
		}

		.diagram-description {
			text-align: center;
			color: rgba(255, 255, 255, 0.7);
			margin-bottom: 2rem;
		}

		/* === Architecture PHP-BDD === */
		.php-bdd-diagram {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
			max-width: 500px;
			margin: 0 auto;
		}

		.diagram-layer {
			display: flex;
			align-items: center;
			gap: 1rem;
			width: 100%;
			padding: 1.5rem;
			border-radius: 12px;
			background: rgba(0, 0, 0, 0.3);
			border: 2px solid;
			transition: transform 0.3s ease;
		}

		.diagram-layer:hover {
			transform: scale(1.02);
		}

		.diagram-layer.app-layer {
			border-color: #667eea;
			background: linear-gradient(135deg, rgba(102, 126, 234, 0.2), rgba(102, 126, 234, 0.05));
		}

		.diagram-layer.pdo-layer {
			border-color: #00ff41;
			background: linear-gradient(135deg, rgba(0, 255, 65, 0.2), rgba(0, 255, 65, 0.05));
		}

		.diagram-layer.db-layer {
			border-color: #f7931e;
			background: linear-gradient(135deg, rgba(247, 147, 30, 0.2), rgba(247, 147, 30, 0.05));
		}

		.layer-icon {
			font-size: 2.5rem;
		}

		.layer-content h4 {
			color: #fff;
			margin: 0 0 0.25rem 0;
		}

		.layer-content p {
			color: rgba(255, 255, 255, 0.6);
			margin: 0 0 0.5rem 0;
			font-size: 0.9rem;
		}

		.layer-content code {
			background: rgba(0, 0, 0, 0.4);
			padding: 0.25rem 0.5rem;
			border-radius: 4px;
			font-size: 0.8rem;
			color: #00ff41;
		}

		.diagram-arrow {
			font-size: 1.2rem;
			color: rgba(255, 255, 255, 0.5);
			padding: 0.5rem;
		}

		.diagram-legend {
			display: flex;
			justify-content: center;
			gap: 2rem;
			margin-top: 1.5rem;
			flex-wrap: wrap;
		}

		.legend-item {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 0.85rem;
			color: rgba(255, 255, 255, 0.7);
		}

		.legend-color {
			width: 16px;
			height: 16px;
			border-radius: 4px;
		}

		.legend-color.app { background: #667eea; }
		.legend-color.pdo { background: #00ff41; }
		.legend-color.db { background: #f7931e; }

		/* === Structure Table SQL === */
		.table-structure-diagram {
			display: flex;
			gap: 2rem;
			align-items: flex-start;
			justify-content: center;
			flex-wrap: wrap;
		}

		.sql-table {
			background: rgba(0, 0, 0, 0.4);
			border-radius: 10px;
			overflow: hidden;
			min-width: 400px;
			border: 2px solid rgba(0, 255, 65, 0.3);
		}

		.table-name {
			background: linear-gradient(135deg, #00ff41, #00cc33);
			color: #000;
			padding: 0.75rem 1rem;
			font-weight: bold;
			text-align: center;
		}

		.table-header {
			display: grid;
			grid-template-columns: 60px 1fr 1fr 1fr;
			background: rgba(0, 255, 65, 0.1);
			border-bottom: 2px solid rgba(0, 255, 65, 0.3);
		}

		.table-header .col {
			padding: 0.75rem;
			font-weight: bold;
			color: #00ff41;
			text-align: center;
			border-right: 1px solid rgba(0, 255, 65, 0.2);
		}

		.table-header .col:last-child {
			border-right: none;
		}

		.table-row {
			display: grid;
			grid-template-columns: 60px 1fr 1fr 1fr;
			border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		}

		.table-row:last-child {
			border-bottom: none;
		}

		.table-row.highlight {
			background: rgba(0, 255, 65, 0.1);
		}

		.table-row .cell {
			padding: 0.75rem;
			color: rgba(255, 255, 255, 0.8);
			text-align: center;
			border-right: 1px solid rgba(255, 255, 255, 0.05);
		}

		.table-row .cell:last-child {
			border-right: none;
		}

		.cell-id {
			color: #f7931e;
			font-weight: bold;
		}

		.table-annotations {
			display: flex;
			flex-direction: column;
			gap: 1rem;
