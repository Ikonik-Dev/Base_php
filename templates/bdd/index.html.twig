			font-size: 1.1rem;
			margin-bottom: 1rem;
			text-align: center;
		}

		.danger .side-header { color: #dc3545; }
		.safe .side-header { color: #28a745; }

		.side-code {
			background: rgba(0, 0, 0, 0.4);
			padding: 1rem;
			border-radius: 8px;
			margin-bottom: 1rem;
		}

		.side-code code {
			font-size: 0.8rem;
			color: #00ff41;
			word-break: break-all;
		}

		.side-attack {
			margin-bottom: 1rem;
		}

		.attack-label {
			font-size: 0.85rem;
			color: rgba(255, 255, 255, 0.6);
			margin-bottom: 0.5rem;
		}

		.side-attack code {
			background: #f7931e;
			color: #000;
			padding: 0.25rem 0.5rem;
			border-radius: 4px;
		}

		.side-result {
			padding: 1rem;
			border-radius: 8px;
		}

		.side-result.bad {
			background: rgba(220, 53, 69, 0.2);
			border: 1px solid rgba(220, 53, 69, 0.3);
		}

		.side-result.good {
			background: rgba(40, 167, 69, 0.2);
			border: 1px solid rgba(40, 167, 69, 0.3);
		}

		.result-label {
			font-size: 0.8rem;
			color: rgba(255, 255, 255, 0.6);
			margin-bottom: 0.5rem;
		}

		.side-result code {
			display: block;
			font-size: 0.75rem;
			color: rgba(255, 255, 255, 0.8);
			word-break: break-all;
			margin-bottom: 0.5rem;
		}

		.side-result p {
			margin: 0;
			font-size: 0.85rem;
		}

		.bad p { color: #dc3545; }
		.good p { color: #28a745; }

		.vs-separator {
			display: flex;
			align-items: center;
			font-size: 1.5rem;
			font-weight: bold;
			color: rgba(255, 255, 255, 0.3);
		}

		/* === Responsive === */
		@media (max-width: 768px) {
			.crud-diagram,
			.acid-diagram {
				grid-template-columns: repeat(2, 1fr);
			}

			.injection-comparison {
				grid-template-columns: 1fr;
			}

			.vs-separator {
				transform: rotate(90deg);
				padding: 1rem 0;
			}

			.table-structure-diagram {
				flex-direction: column;
				align-items: center;
			}

			.sql-table {
				min-width: 100%;
			}

			.join-tables {
				flex-direction: column;
			}
		}

		@media (max-width: 480px) {
			.crud-diagram,
			.acid-diagram {
				grid-template-columns: 1fr;
			}
		}
