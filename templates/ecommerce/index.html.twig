{% extends 'base.html.twig' %}

{% block title %}
	{{ pageTitle }}
	- Cours PHP Matrix
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/ecommerce.css') }}">
	<link rel="stylesheet" href="{{ asset('styles/modal-etape.css') }}">
	<link rel="stylesheet" href="{{ asset('styles/modal-concept.css') }}">
{% endblock %}

{% block body %}
	<div
		class="ecommerce-page">
		<!-- Header avec style spécifique E-commerce -->
		<header class="ecommerce-header">
			<div class="container">
				<h1 class="page-title">
					<span class="icon">🛒</span>
					{{ presentation.label }}
				</h1>
				<p class="page-subtitle">
					{{ presentation.description }}
				</p>
				<div class="ecommerce-stats">
					<div class="stat-item">
						<strong>Niveau :</strong>
						{{ presentation.niveau }}
					</div>
					<div class="stat-item">
						<strong>Durée :</strong>
						{{ presentation.duree_estimee }}
					</div>
					<div class="stat-item">
						<strong>Étapes :</strong>
						{{ etapes|length }}
					</div>
				</div>
			</div>
		</header>

		<!-- Navigation rapide -->
		<nav class="quick-nav">
			<div class="container">
				<div class="nav-pills">
					<a href="#presentation" class="nav-pill">Introduction</a>
					<a href="#roadmap" class="nav-pill">Roadmap</a>
					<a href="#concepts" class="nav-pill">Concepts</a>
					<a href="#technologies" class="nav-pill">Technologies</a>
					<a href="#commencer" class="nav-pill">Commencer</a>
				</div>
			</div>
		</nav>

		<!-- Contenu principal -->
		<main class="main-content">
			<div
				class="container">

				<!-- Section Introduction -->
				<section id="presentation" class="concept-section">
					<h2>🎯 À propos de ce Tutoriel</h2>
					<div class="intro-grid">
						<div class="intro-card">
							<div class="card-icon">🎓</div>
							<h3>Approche Pédagogique</h3>
							<p>Construction progressive d'un site e-commerce complet en appliquant les concepts Symfony. Chaque étape builds sur la précédente avec des explications détaillées.</p>
						</div>
						<div class="intro-card">
							<div class="card-icon">💼</div>
							<h3>Projet Concret</h3>
							<p>Développement d'une boutique en ligne fonctionnelle avec catalogue produits, panier, commandes et interface d'administration.</p>
						</div>
						<div class="intro-card">
							<div class="card-icon">🚀</div>
							<h3>Bonnes Pratiques</h3>
							<p>Application des design patterns, sécurité, tests et optimisations selon les standards Symfony et l'industrie.</p>
						</div>
					</div>

					<!-- Prérequis -->
					<div class="prerequisites-section">
						<h3>📋 Prérequis</h3>
						<div class="prerequisites-grid">
							{% for prerequis in presentation.prerequis %}
								<div class="prerequis-item">
									<span class="prerequis-icon">✓</span>
									<span>{{ prerequis }}</span>
								</div>
							{% endfor %}
						</div>
					</div>
				</section>

				<!-- Section Roadmap -->
				<section id="roadmap" class="concept-section">
					<h2>🗺️ Plan de Développement</h2>
					<div class="roadmap-container">
						{% for etape in etapes %}
							<div class="roadmap-step {% if loop.index is odd %}step-left{% else %}step-right{% endif %}" data-open-modal="etape-{{ etape.numero }}" role="button" tabindex="0">
								<div class="step-number">{{ etape.numero }}</div>
								<div class="step-content">
									<div class="step-header">
										<h3>{{ etape.titre }}</h3>
										<span class="step-duration">⏱️
											{{ etape.duree }}</span>
									</div>
									<p class="step-description">{{ etape.description }}</p>

									<!-- Concepts abordés -->
									<div class="step-concepts">
										<h4>🧠 Concepts :</h4>
										<div class="concept-tags">
											{% for concept in etape.concepts %}
												<span class="concept-tag">{{ concept }}</span>
											{% endfor %}
										</div>
									</div>

									<!-- Objectifs -->
									<div class="step-objectives">
										<h4>🎯 Objectifs :</h4>
										<ul>
											{% for objectif in etape.objectifs %}
												<li>{{ objectif }}</li>
											{% endfor %}
										</ul>
									</div>

									<!-- Livrables -->
									<div class="step-deliverables">
										<h4>📦 Livrables :</h4>
										<ul>
											{% for livrable in etape.livrables %}
												<li>{{ livrable }}</li>
											{% endfor %}
										</ul>
									</div>
								</div>
							</div>

							{% if not loop.last %}
								<div class="roadmap-connector">
									<div class="connector-line"></div>
									<div class="connector-arrow">⬇️</div>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</section>

				<!-- Section Concepts Techniques -->
				<section id="concepts" class="concept-section">
					<h2>🏗️ Concepts Techniques</h2>

					<!-- Architecture -->
					<div class="concept-detail">
						<h3>{{ concepts_techniques.architecture.label }}</h3>
						<p class="concept-description">{{ concepts_techniques.architecture.description }}</p>

					<div class="architecture-diagram">
						{% for nom, description in concepts_techniques.architecture.composants %}
							<div class="architecture-component" 
							     data-open-modal="concept-architecture-{{ nom|lower }}" 
							     role="button" 
							     tabindex="0"
							     style="cursor: pointer;">
								<div class="component-icon">
									{% if nom == 'Frontend' %}🖥️
										{% elseif nom == 'Backend' %}⚙️
										{% elseif nom == 'Database' %}🗄️
										{% else %}🔐
									{% endif %}
								</div>
								<h4>{{ nom }}</h4>
								<p>{{ description }}</p>
								<span class="click-hint">Cliquer pour détails 👉</span>
							</div>
						{% endfor %}
					</div>
					</div>

					<!-- Design Patterns -->
					<div class="concept-detail">
						<h3>{{ concepts_techniques.patterns.label }}</h3>
						<p class="concept-description">{{ concepts_techniques.patterns.description }}</p>

					<div class="patterns-grid">
						{% for pattern, description in concepts_techniques.patterns.liste %}
							<div class="pattern-card" 
							     data-open-modal="concept-pattern-{{ pattern|lower|replace({' ': '-', ' pattern': ''}) }}" 
							     role="button" 
							     tabindex="0"
							     style="cursor: pointer;">
								<h4>{{ pattern }}</h4>
								<p>{{ description }}</p>
								<span class="click-hint">Cliquer pour détails 👉</span>
							</div>
						{% endfor %}
					</div>
					</div>

					<!-- Sécurité -->
					<div class="concept-detail">
						<h3>{{ concepts_techniques.securite.label }}</h3>
						<p class="concept-description">{{ concepts_techniques.securite.description }}</p>

					<div class="security-grid">
						{% for mesure, description in concepts_techniques.securite.mesures %}
							<div class="security-item" 
							     data-open-modal="concept-security-{{ mesure|lower|replace({' ': '-', ' protection': '', ' prevention': ''}) }}" 
							     role="button" 
							     tabindex="0"
							     style="cursor: pointer;">
								<div class="security-icon">🛡️</div>
								<h4>{{ mesure }}</h4>
								<p>{{ description }}</p>
								<span class="click-hint">Cliquer pour détails 👉</span>
							</div>
						{% endfor %}
					</div>
					</div>
				</section>

				<!-- Section Technologies -->
				<section id="technologies" class="concept-section">
					<h2>🛠️ Stack Technologique</h2>

					<div
						class="tech-stack">
						<!-- Backend -->
						<div class="tech-category">
							<h3>⚙️ Backend</h3>
							<div class="tech-grid">
								{% for tech, description in technologies.backend %}
									{% set slug = tech|lower|replace({' ': '_', '+': '', '.': '_'}) %}
									<div class="tech-item" 
										 data-open-modal="tech-backend-{{ slug }}" 
										 role="button" 
										 tabindex="0"
										 style="cursor: pointer;">
										<h4>{{ tech }}</h4>
										<p>{{ description }}</p>
										<span class="click-hint">Cliquer pour détails 👉</span>
									</div>
								{% endfor %}
							</div>
						</div>

						<!-- Frontend -->
						<div class="tech-category">
							<h3>🖥️ Frontend</h3>
							<div class="tech-grid">
								{% for tech, description in technologies.frontend %}
									{% set slug = tech|lower|replace({' ': '_', '+': ''}) %}
									<div class="tech-item" 
										 data-open-modal="tech-frontend-{{ slug }}" 
										 role="button" 
										 tabindex="0"
										 style="cursor: pointer;">
										<h4>{{ tech }}</h4>
										<p>{{ description }}</p>
										<span class="click-hint">Cliquer pour détails 👉</span>
									</div>
								{% endfor %}
							</div>
						</div>

						<!-- Outils -->
						<div class="tech-category">
							<h3>🔧 Outils de Développement</h3>
							<div class="tech-grid">
								{% for tech, description in technologies.outils %}
									{% set slug = tech|lower|replace({' ': '_', '+': ''}) %}
									<div class="tech-item" 
										 data-open-modal="tech-outils-{{ slug }}" 
										 role="button" 
										 tabindex="0"
										 style="cursor: pointer;">
										<h4>{{ tech }}</h4>
										<p>{{ description }}</p>
										<span class="click-hint">Cliquer pour détails 👉</span>
									</div>
								{% endfor %}
							</div>
						</div>
					</div>
				</section>

				<!-- Section Commencer -->
				<section id="commencer" class="concept-section">
					<h2>🚀 Prêt à Commencer ?</h2>

					<div class="getting-started">
						<div class="start-card">
							<div class="start-icon">📚</div>
							<h3>1. Préparez votre Environnement</h3>
							<p>Assurez-vous d'avoir PHP 8.1+, Composer, et une base de données (MySQL/PostgreSQL) installés.</p>
						</div>

						<div class="start-card">
							<div class="start-icon">💻</div>
							<h3>2. Suivez le Guide</h3>
							<p>Chaque étape contient le code complet avec explications. Prenez le temps de comprendre avant de passer à la suite.</p>
						</div>

						<div class="start-card">
							<div class="start-icon">🎯</div>
							<h3>3. Pratiquez</h3>
							<p>Implémentez chaque fonctionnalité et n'hésitez pas à expérimenter avec vos propres améliorations.</p>
						</div>
					</div>

					<!-- Bouton de démarrage -->
					<div class="start-action">
						<div class="action-card">
							<h3>🎪 Commencer le Tutoriel</h3>
							<p>Prêt à construire votre site e-commerce ? Commençons par l'étape 1 !</p>
							<button class="btn-primary btn-large" onclick="scrollToSection('roadmap')">
								Démarrer l'Étape 1 🚀
							</button>
						</div>
					</div>
				</section>

				<!-- Tips et Best Practices -->
				<section class="tips-section">
					<h2>💡 Conseils pour Réussir</h2>

					<div class="tips-grid">
						<div class="tip-card">
							<div class="tip-icon">🔄</div>
							<h3>Développement Itératif</h3>
							<p>Testez chaque fonctionnalité avant de passer à la suivante. Un code qui fonctionne vaut mieux qu'un code parfait non testé.</p>
						</div>

						<div class="tip-card">
							<div class="tip-icon">📖</div>
							<h3>Documentation</h3>
							<p>Consultez la documentation officielle Symfony pour approfondir vos connaissances sur chaque composant utilisé.</p>
						</div>

						<div class="tip-card">
							<div class="tip-icon">🐛</div>
							<h3>Debug</h3>
							<p>Utilisez le Symfony Profiler et les logs pour identifier et résoudre rapidement les problèmes.</p>
						</div>

						<div class="tip-card">
							<div class="tip-icon">🔒</div>
							<h3>Sécurité</h3>
							<p>Pensez sécurité dès le début : validation des données, protection CSRF, et gestion des permissions.</p>
						</div>
					</div>
				</section>

			</div>
		</main>
	</div>

	<!-- Modales pour chaque étape -->
	{% for etape in etapes %}
		{% if etape.modal_details is defined %}
			{% set details = etape.modal_details %}
			{% include 'components/modal-etape.html.twig' with {
				'id': 'etape-' ~ etape.numero,
				'title': 'Étape ' ~ etape.numero ~ ' : ' ~ etape.titre,
				'icon': etape.icon|default('🚀'),
				'description': details.description_detaillee,
				'details': '<div class="etape-info"><strong>⏱️ Durée estimée :</strong> ' ~ etape.duree ~ '</div>',
				'commandes': details.commandes|default([]),
				'fichiers': details.fichiers_a_creer|default([]),
				'bestPractices': details.checklist|default([]),
				'warnings': details.pieges_communs|default([]),
				'resources': details.ressources|default([]),
				'prevStep': etape.numero > 1 ? etape.numero - 1 : null,
				'nextStep': etape.numero < etapes|length ? etape.numero + 1 : null
			} %}
		{% endif %}
	{% endfor %}

	<!-- Modales pour Architecture -->
	{% if concepts_techniques.architecture.composants_details is defined %}
		{% set composants = concepts_techniques.architecture.composants_details|keys %}
		{% for nom in composants %}
			{% set details = concepts_techniques.architecture.composants_details[nom] %}
			{% set currentIndex = loop.index0 %}
			{% include 'components/modal-concept.html.twig' with {
				'id': 'concept-architecture-' ~ nom|lower,
				'title': nom,
				'icon': nom == 'Frontend' ? '🖥️' : (nom == 'Backend' ? '⚙️' : (nom == 'Database' ? '🗄️' : '🔐')),
				'description': details.description_detaillee,
				'analogie': details.analogie,
				'cas_usage': details.cas_usage,
				'exemple_code': details.exemple_code,
				'avantages': details.avantages,
				'inconvenients': details.inconvenients,
				'ressources': details.ressources,
				'prevConcept': currentIndex > 0 ? 'concept-architecture-' ~ composants[currentIndex - 1]|lower : null,
				'nextConcept': currentIndex < (composants|length - 1) ? 'concept-architecture-' ~ composants[currentIndex + 1]|lower : null
			} %}
		{% endfor %}
	{% endif %}

	<!-- Modales pour Technologies Backend -->
	{% if technologies.backend_details is defined %}
		{% set backendNames = technologies.backend_details|keys %}
		{% for name in backendNames %}
			{% set details = technologies.backend_details[name] %}
			{% set currentIndex = loop.index0 %}
			{% set slug = name|lower|replace({' ': '_', '+': '', '.': '_'}) %}
			{% include 'components/modal-concept.html.twig' with {
				'id': 'tech-backend-' ~ slug,
				'title': name,
				'icon': '⚙️',
				'description': details.description_detaillee,
				'analogie': details.analogie,
				'cas_usage': details.cas_usage,
				'exemple_code': details.exemple_code,
				'avantages': details.avantages,
				'inconvenients': details.inconvenients,
				'ressources': details.ressources,
				'prevConcept': currentIndex > 0 ? 'tech-backend-' ~ (backendNames[currentIndex - 1]|lower|replace({' ': '_', '+': '', '.': '_' })) : null,
				'nextConcept': currentIndex < (backendNames|length - 1) ? 'tech-backend-' ~ (backendNames[currentIndex + 1]|lower|replace({' ': '_', '+': '', '.': '_' })) : null
			} %}
		{% endfor %}
	{% endif %}

	<!-- Modales pour Technologies Frontend -->
	{% if technologies.frontend_details is defined %}
		{% set frontendNames = technologies.frontend_details|keys %}
		{% for name in frontendNames %}
			{% set details = technologies.frontend_details[name] %}
			{% set currentIndex = loop.index0 %}
			{% set slug = name|lower|replace({' ': '_', '+': ''}) %}
			{% include 'components/modal-concept.html.twig' with {
				'id': 'tech-frontend-' ~ slug,
				'title': name,
				'icon': '🖥️',
				'description': details.description_detaillee,
				'analogie': details.analogie,
				'cas_usage': details.cas_usage,
				'exemple_code': details.exemple_code,
				'avantages': details.avantages,
				'inconvenients': details.inconvenients,
				'ressources': details.ressources,
				'prevConcept': currentIndex > 0 ? 'tech-frontend-' ~ (frontendNames[currentIndex - 1]|lower|replace({' ': '_', '+': '' })) : null,
				'nextConcept': currentIndex < (frontendNames|length - 1) ? 'tech-frontend-' ~ (frontendNames[currentIndex + 1]|lower|replace({' ': '_', '+': '' })) : null
			} %}
		{% endfor %}
	{% endif %}

	<!-- Modales pour Outils de Développement -->
	{% if technologies.outils_details is defined %}
		{% set outilsNames = technologies.outils_details|keys %}
		{% for name in outilsNames %}
			{% set details = technologies.outils_details[name] %}
			{% set currentIndex = loop.index0 %}
			{% set slug = name|lower|replace({' ': '_', '+': ''}) %}
			{% include 'components/modal-concept.html.twig' with {
				'id': 'tech-outils-' ~ slug,
				'title': name,
				'icon': '🔧',
				'description': details.description_detaillee,
				'analogie': details.analogie,
				'cas_usage': details.cas_usage,
				'exemple_code': details.exemple_code,
				'avantages': details.avantages,
				'inconvenients': details.inconvenients,
				'ressources': details.ressources,
				'prevConcept': currentIndex > 0 ? 'tech-outils-' ~ (outilsNames[currentIndex - 1]|lower|replace({' ': '_', '+': '' })) : null,
				'nextConcept': currentIndex < (outilsNames|length - 1) ? 'tech-outils-' ~ (outilsNames[currentIndex + 1]|lower|replace({' ': '_', '+': '' })) : null
			} %}
		{% endfor %}
	{% endif %}

	<!-- Modales pour Design Patterns -->
	{% if concepts_techniques.patterns.liste_details is defined %}
		{% set patterns = concepts_techniques.patterns.liste_details|keys %}
		{% for pattern in patterns %}
			{% set details = concepts_techniques.patterns.liste_details[pattern] %}
			{% set currentIndex = loop.index0 %}
			{% set slug = pattern|lower|replace({' ': '-', ' pattern': ''}) %}
			{% include 'components/modal-concept.html.twig' with {
				'id': 'concept-pattern-' ~ slug,
				'title': pattern,
				'icon': '🏗️',
				'description': details.description_detaillee,
				'analogie': details.analogie,
				'cas_usage': details.cas_usage,
				'exemple_code': details.exemple_code,
				'avantages': details.avantages,
				'inconvenients': details.inconvenients,
				'ressources': details.ressources,
				'prevConcept': currentIndex > 0 ? 'concept-pattern-' ~ (patterns[currentIndex - 1]|lower|replace({' ': '-', ' pattern': ''})) : null,
				'nextConcept': currentIndex < (patterns|length - 1) ? 'concept-pattern-' ~ (patterns[currentIndex + 1]|lower|replace({' ': '-', ' pattern': ''})) : null
			} %}
		{% endfor %}
	{% endif %}

	<!-- Modales pour Sécurité -->
	{% if concepts_techniques.securite.mesures_details is defined %}
		{% set mesures = concepts_techniques.securite.mesures_details|keys %}
		{% for mesure in mesures %}
			{% set details = concepts_techniques.securite.mesures_details[mesure] %}
			{% set currentIndex = loop.index0 %}
			{% set slug = mesure|lower|replace({' ': '-', ' protection': '', ' prevention': ''}) %}
			{% include 'components/modal-concept.html.twig' with {
				'id': 'concept-security-' ~ slug,
				'title': mesure,
				'icon': '🛡️',
				'description': details.description_detaillee,
				'analogie': details.analogie,
				'cas_usage': details.cas_usage,
				'exemple_code': details.exemple_code,
				'avantages': details.avantages,
				'inconvenients': details.inconvenients,
				'ressources': details.ressources,
				'prevConcept': currentIndex > 0 ? 'concept-security-' ~ (mesures[currentIndex - 1]|lower|replace({' ': '-', ' protection': '', ' prevention': ''})) : null,
				'nextConcept': currentIndex < (mesures|length - 1) ? 'concept-security-' ~ (mesures[currentIndex + 1]|lower|replace({' ': '-', ' protection': '', ' prevention': ''})) : null
			} %}
		{% endfor %}
	{% endif %}

	<script src="{{ asset('js/modal-etape-manager.js') }}"></script>
	<script>
		function scrollToSection(sectionId) {
			document.getElementById(sectionId).scrollIntoView({behavior: 'smooth'});
		}

		// Rendre TOUS les éléments avec data-open-modal cliquables au clavier
		document.querySelectorAll('[data-open-modal]').forEach(card => {
			card.addEventListener('keypress', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					card.click();
				}
			});
		});
	</script>
{% endblock %}
