}

.tab-header:hover {
	background: var(--symfony-light);
	color: white;
}

.tab-content {
	display: none;
	animation: fadeInScale 0.8s ease-out;
}

.tab-content.active {
	display: block;
}

.ecosystem-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
	gap: 1.5rem;
}

.ecosystem-card {
	background: white;
	padding: 1.5rem;
	border-radius: 10px;
	box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
