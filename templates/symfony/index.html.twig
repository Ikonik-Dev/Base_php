}

/* Workflow */
.workflow-steps {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
	gap: 2rem;
	margin: 2rem 0;
}

.workflow-step {
	background: white;
	padding: 2rem;
	border-radius: 15px;
	box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
	text-align: center;
	animation: slideInUp 1s ease-out;
}

.workflow-step:nth-child(1) {
	animation-delay: 0.2s;
}
.workflow-step:nth-child(2) {
	animation-delay: 0.4s;
}
.workflow-step:nth-child(3) {
	animation-delay: 0.6s;
}

.step-icon {
	font-size: 3rem;
	margin-bottom: 1rem;
	animation: bounce 2s infinite;
}

/* Styles code et commandes */
code {
	background: #f8f9fa;
	padding: 0.5rem;
	border-radius: 5px;
	font-family: 'Courier New', monospace;
	color: var(--symfony-primary);
}

pre code {
	display: block;
	padding: 1rem;
	background: #2d3748;
	color: #e2e8f0;
	border-radius: 8px;
}

/* CTA Section */
.cta-section {
	background: var(--symfony-gradient);
	color: white;
	padding: 3rem 2rem;
	border-radius: 20px;
	text-align: center;
	margin: 3rem 0;
	animation: slideInUp 1s ease-out;
}

.cta-buttons {
	display: flex;
	gap: 1rem;
	justify-content: center;
