{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Fonctions
{% endblock %}

{% block body %}
	<!-- Header spécifique aux fonctions -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// FONCTIONS PHP</h1>
				<p class="header-subtitle">
					Maîtrisez les fonctions PHP : déclaration, paramètres, types, closures et fonctionnalités modernes PHP 7/8.
															Créez du code réutilisable, modulaire et élégant avec les techniques avancées des fonctions.
				</p>
			</div>
		</div>
	</header>

	<!-- Contenu principal - Fonctions -->
	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Déclaration & paramètres</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['declaration_fonctions', 'parametres_arguments', 'parametres_variables', 'valeurs_retour'] %}
						{% include 'components/card.html.twig' with {
							'modalId': 'modal-' ~ key,
							'title': key|replace({'_': ' '})|title,
							'description': concept.description,
							'example': concept.example
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Types & PHP 7/8 -->
			<h2 class="section-title">Types & fonctionnalités modernes</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['types_parametres_php7', 'types_union_php8', 'named_arguments_php8', 'first_class_callable_php81'] %}
						{% include 'components/card.html.twig' with {
							'modalId': 'modal-' ~ key,
							'title': key|replace({'_': ' ', 'php7': 'PHP 7', 'php8': 'PHP 8', 'php81': 'PHP 8.1'})|title,
							'description': concept.description,
							'example': concept.example
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Portée & closures -->
			<h2 class="section-title">Portée & closures</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['portee_variables', 'fonctions_anonymes', 'fonctions_flechees_php74', 'fonctions_callback'] %}
						{% include 'components/card.html.twig' with {
							'modalId': 'modal-' ~ key,
							'title': key|replace({'_': ' ', 'php74': 'PHP 7.4'})|title,
							'description': concept.description,
							'example': concept.example
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Avancées -->
			<h2 class="section-title">Fonctionnalités avancées</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['generateurs_yield', 'recursivite', 'fonctions_variables', 'attributes_php8'] %}
						{% include 'components/card.html.twig' with {
						'modalId': 'modal-' ~ key,
						'title': key|replace({'_': ' ', 'php8': 'PHP 8'})|title,
						'description': concept.description,
						'example': concept.example
					} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Comparaison -->
			<h2 class="section-title">Comparaison inter-langages</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key == 'comparaison_php_javascript' %}
						{% include 'components/card.html.twig' with {
						'modalId': 'modal-' ~ key,
						'title': 'PHP vs JavaScript',
						'description': concept.description,
						'example': concept.example,
						'icon': '⚖️'
					} %}
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</main>

	<!-- Modales -->
	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
			'id': 'modal-' ~ key,
			'title': key|replace({'_': ' ', 'php7': 'PHP 7', 'php74': 'PHP 7.4', 'php8': 'PHP 8', 'php81': 'PHP 8.1'})|title,
			'description': concept.description,
			'example': concept.example,
			'details': concept.details|default(null),
			'useCases': concept.useCases|default([]),
			'warnings': concept.warnings|default([]),
			'bestPractices': concept.bestPractices|default([]),
			'resources': concept.resources|default([]),
			'relatedTopics': concept.relatedTopics|default([])
		} %}
	{% endfor %}

{% endblock %}
