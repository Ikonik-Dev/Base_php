{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Types de données
{% endblock %}

{% block body %}
	<!-- Header spécifique aux types -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// TYPES DE DONNÉES PHP</h1>
				<p class="header-subtitle">
					Explorez tous les types de données en PHP : primitifs, composés, spéciaux, conversion et vérification.
															Maîtrisez le système de typage pour un code plus robuste et performant.
				</p>
			</div>
		</div>
	</header>

	<!-- Contenu principal - Types de données -->
	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Types primitifs & scalaires</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['types_primitifs_scalaires', 'type_integer', 'type_float', 'type_string', 'type_boolean'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'_': ' ', 'type ': ''})|title,
							'description': concept.description,
							'icon': '🔢',
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Types composés -->
			<h2 class="section-title">Types composés</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['types_composes', 'type_array', 'type_object'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'_': ' ', 'type ': ''})|title,
							'description': concept.description,
							'icon': '📦',
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Types spéciaux -->
			<h2 class="section-title">Types spéciaux</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['types_speciaux', 'type_null', 'type_resource', 'type_callable'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'_': ' ', 'type ': ''})|title,
							'description': concept.description,
							'icon': '✨',
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Gestion des types -->
			<h2 class="section-title">Gestion & conversion des types</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['verification_types', 'conversion_types', 'juggling_types', 'types_hints'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'_': ' '})|title,
							'description': concept.description,
							'icon': '🔄',
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</main>

	<!-- Modales pour tous les concepts -->
	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
			'id': 'modal-' ~ key,
			'title': key|replace({'_': ' ', 'type ': ''})|title,
			'icon': key starts with 'types_primitifs' or key starts with 'type_int' or key starts with 'type_float' or key starts with 'type_string' or key starts with 'type_boolean' ? '🔢' : (key starts with 'types_composes' or key starts with 'type_array' or key starts with 'type_object' ? '📦' : (key starts with 'types_speciaux' or key starts with 'type_null' or key starts with 'type_resource' or key starts with 'type_callable' ? '✨' : '🔄')),
			'description': concept.description,
			'details': concept.details ?? null,
			'example': concept.example ?? null,
			'useCases': concept.useCases ?? null,
			'warnings': concept.warnings ?? null,
			'bestPractices': concept.bestPractices ?? null,
			'resources': concept.resources ?? null,
			'relatedTopics': concept.relatedTopics ?? null
		} %}
	{% endfor %}

	<!-- Effet Matrix de fond -->
	<div class="matrix-bg" id="matrix-canvas"></div>

	<style>
		/* Styles spécifiques à la page Types */
		.section-title {
			color: var(--matrix-green);
			font-size: 2rem;
			margin: 3rem 0 2rem;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 2px;
			border-bottom: 2px solid var(--matrix-green);
			padding-bottom: 1rem;
		}

		/* Responsiveness améliorée */
		@media(max-width: 768px) {
			.section-title {
				font-size: 1.5rem;
			}
		}
	</style>
{% endblock %}
