{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Opérateurs
{% endblock %}

{% block body %}
	<!-- Header spécifique aux opérateurs -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// OPÉRATEURS PHP</h1>
				<p class="header-subtitle">
					Maîtrisez tous les opérateurs PHP : arithmétiques, logiques, comparaison, affectation et spéciaux.
															Chaque opérateur est un outil puissant pour manipuler et transformer vos données.
				</p>
			</div>
		</div>
	</header>

	<!-- Contenu principal - Opérateurs -->
	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Opérateurs de base</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_arithmetiques', 'operateurs_comparaison', 'operateurs_logiques', 'operateurs_affectation'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'operateurs_': '', '_': ' '})|title,
							'description': concept.description,
							'icon': '➕',
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Opérateurs spécialisés -->
			<h2 class="section-title">Opérateurs spécialisés</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_incrementation', 'operateurs_concatenation', 'operateurs_tableaux', 'operateurs_ternaire'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'operateurs_': '', '_': ' '})|title,
							'description': concept.description,
							'icon': key == 'operateurs_incrementation' ? '🔢' : (key == 'operateurs_concatenation' ? '🔗' : (key == 'operateurs_tableaux' ? '📦' : '❓')),
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Opérateurs avancés -->
			<h2 class="section-title">Opérateurs avancés</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_null_coalescing', 'operateurs_bitwise', 'operateurs_instanceof', 'operateurs_type'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'operateurs_': '', '_': ' '})|title,
							'description': concept.description,
							'icon': key == 'operateurs_null_coalescing' ? '❓' : (key == 'operateurs_bitwise' ? '⚙️' : (key == 'operateurs_instanceof' ? '🔍' : '🔄')),
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Opérateurs système & précédence -->
			<h2 class="section-title">Système & précédence</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_execution', 'operateurs_suppression_erreur', 'precedence_operateurs'] %}
						{% include 'components/card.html.twig' with {
							'title': key|replace({'operateurs_': '', '_': ' '})|title,
							'description': concept.description,
							'icon': key == 'operateurs_execution' ? '⚠️' : (key == 'operateurs_suppression_erreur' ? '🚫' : '📊'),
							'modalId': 'modal-' ~ key
						} %}
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</main>

	<!-- Modales pour chaque opérateur -->
	{% for key, concept in data %}
		{% include 'components/modal.html.twig' with {
			'id': 'modal-' ~ key,
			'title': key|replace({'operateurs_': '', '_': ' '})|title,
			'description': concept.description,
			'details': concept.details,
			'example': concept.example,
			'useCases': concept.useCases,
			'warnings': concept.warnings,
			'bestPractices': concept.bestPractices,
			'resources': concept.resources,
			'relatedTopics': concept.relatedTopics
		} %}
	{% endfor %}

	<!-- Effet Matrix de fond -->
	<div class="matrix-bg" id="matrix-canvas"></div>

	<style>
		.section-title {
			color: var(--matrix-green);
			font-size: 2rem;
			margin: 3rem 0 2rem;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 2px;
			border-bottom: 2px solid var(--matrix-green);
			padding-bottom: 1rem;
		}

		@media(max-width: 768px) {
			.section-title {
				font-size: 1.5rem;
			}
		}
	</style>
{% endblock %}
