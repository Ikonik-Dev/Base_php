{% extends 'base.html.twig' %}

{% block title %}Cours PHP - Opérateurs
{% endblock %}

{% block body %}
	<!-- Header spécifique aux opérateurs -->
	<header class="header">
		<div class="container">
			<div class="header-content">
				<h1 class="header-title">// OPÉRATEURS PHP</h1>
				<p class="header-subtitle">
					Maîtrisez tous les opérateurs PHP : arithmétiques, logiques, comparaison, affectation et spéciaux.
										Chaque opérateur est un outil puissant pour manipuler et transformer vos données.
				</p>
			</div>
		</div>
	</header>

	<!-- Contenu principal - Opérateurs -->
	<main class="main-content">
		<div class="container">
			<h2 class="section-title">Opérateurs de base</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_arithmetiques', 'operateurs_comparaison', 'operateurs_logiques', 'operateurs_affectation'] %}
						<article id="{{ key }}" class="concept-card basic-operator-card">
							<h3 class="concept-card-title">
								{{ key|replace({'operateurs_': '', '_': ' '})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Opérateurs spécialisés -->
			<h2 class="section-title">Opérateurs spécialisés</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_incrementation', 'operateurs_concatenation', 'operateurs_tableaux', 'operateurs_ternaire'] %}
						<article id="{{ key }}" class="concept-card specialized-operator-card">
							<h3 class="concept-card-title">
								{{ key|replace({'operateurs_': '', '_': ' '})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Opérateurs avancés -->
			<h2 class="section-title">Opérateurs avancés</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_null_coalescing', 'operateurs_bitwise', 'operateurs_instanceof', 'operateurs_type'] %}
						<article id="{{ key }}" class="concept-card advanced-operator-card">
							<h3 class="concept-card-title">
								{{ key|replace({'operateurs_': '', '_': ' '})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>

			<!-- Section Opérateurs système & précédence -->
			<h2 class="section-title">Système & précédence</h2>
			<div class="grid">
				{% for key, concept in data %}
					{% if key in ['operateurs_execution', 'operateurs_suppression_erreur', 'precedence_operateurs'] %}
						<article id="{{ key }}" class="concept-card system-operator-card">
							<h3 class="concept-card-title">
								{{ key|replace({'operateurs_': '', '_': ' '})|title }}
							</h3>
							<p class="concept-card-description">
								{{ concept.description }}
							</p>
							<div class="concept-card-example">
								<strong>Exemple :</strong><br>
								<pre><code>{{ concept.example }}</code></pre>
							</div>
						</article>
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</main>

	<!-- Effet Matrix de fond -->
	<div class="matrix-bg" id="matrix-canvas"></div>

	<script>
		// Script pour l'effet Matrix et animations
document.addEventListener('DOMContentLoaded', function () { // Animation d'apparition des cartes
const cards = document.querySelectorAll('.concept-card');

cards.forEach((card, index) => {
card.style.animationDelay = `${
index * 0.1
}s`;
card.style.animation = 'fadeInUp 0.6s ease-out forwards';

// Effet de hover avancé
card.addEventListener('mouseenter', function () {
this.style.transform = 'translateY(-8px) scale(1.02)';
});

card.addEventListener('mouseleave', function () {
this.style.transform = 'translateY(0) scale(1)';
});
});

// Smooth scroll pour la navigation (si présente)
document.querySelectorAll('.nav-link').forEach(link => {
link.addEventListener('click', function (e) {
e.preventDefault();
const targetId = this.getAttribute('href').substring(1);
const targetElement = document.getElementById(targetId);

if (targetElement) {
targetElement.scrollIntoView({behavior: 'smooth', block: 'center'});

// Effet de highlight temporaire
targetElement.style.boxShadow = '0 0 20px var(--matrix-glow)';
setTimeout(() => {
targetElement.style.boxShadow = '';
}, 2000);
}
});
});
});
	</script>

	<style>
		/* Styles spécifiques à la page Opérateurs */
		.section-title {
			color: var(--matrix-green);
			font-size: 2rem;
			margin: 3rem 0 2rem;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 2px;
			border-bottom: 2px solid var(--matrix-green);
			padding-bottom: 1rem;
		}

		/* Animations personnalisées */
		@keyframes fadeInUp {
			from {
				opacity: 0;
				transform: translateY(30px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		/* Style initial pour les cartes avant animation */
		.concept-card {
			opacity: 0;
		}

		/* Styles spéciaux par catégorie d'opérateurs */
		.basic-operator-card {
			border-left: 4px solid #00ff41; /* Vert Matrix pour les bases */
		}

		.specialized-operator-card {
			border-left: 4px solid #41ff00; /* Vert clair pour spécialisés */
		}

		.advanced-operator-card {
			border-left: 4px solid #0041ff; /* Bleu pour avancés */
		}

		.system-operator-card {
			border-left: 4px solid #ff4100; /* Orange pour système/précédence */
		}

		/* Titres colorés par catégorie */
		.basic-operator-card .concept-card-title {
			color: #00ff41;
		}

		.specialized-operator-card .concept-card-title {
			color: #41ff00;
		}

		.advanced-operator-card .concept-card-title {
			color: #0041ff;
		}

		.system-operator-card .concept-card-title {
			color: #ff4100;
		}

		/* Style pour l'effet de focus sur les cartes */
		.concept-card:focus {
			outline: 2px solid var(--matrix-green);
			outline-offset: 2px;
		}

		/* Amélioration des exemples de code */
		.concept-card-example pre {
			background: rgba(0, 0, 0, 0.3);
			border: 1px solid var(--matrix-green);
			border-radius: 4px;
			padding: 1rem;
			margin-top: 0.5rem;
			overflow-x: auto;
		}

		.concept-card-example code {
			color: var(--matrix-green);
			font-family: 'Courier New', monospace;
			font-size: 0.9rem;
			line-height: 1.4;
			white-space: pre;
		}

		.concept-card-example::before {
			content: '$ ';
			color: var(--matrix-green);
			font-weight: bold;
		}

		/* Responsiveness améliorée */
		@media(max-width: 768px) {
			.section-title {
				font-size: 1.5rem;
			}

			.concept-card-example pre {
				font-size: 0.8rem;
				padding: 0.5rem;
			}
		}
	</style>
{% endblock %}
